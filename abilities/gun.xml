<?xml version="1.0" encoding="utf-8"?>
<abilitygroup>
  <abilitygroupinfo>
    <abilitygrouptitle>Gun Proficiency</abilitygrouptitle>
    <abilitygroupid><gun/></abilitygroupid>
    <abilitygroupfamily><martial/></abilitygroupfamily>
    <keywords><gun/><martial/></keywords>    
    <abilitygroupdescription>
      <p>
        Represents training the ability to use of pistols and blunderbuss.
      </p>
    </abilitygroupdescription>
    <enabled/>
  </abilitygroupinfo>
  

  <ability>
    <abilitytitle>Gun Maintenance</abilitytitle>
    <abilityid>gun_maintenance</abilityid>
    <abilityranks untrained="-3" from="0" to="3"/>
    <abilitytrigger>
      <name>Reload</name>
      <actiontype><ap4/></actiontype>
      <range><touch/></range>
      <precondition>Holding an empty crossbow.</precondition>
      <effect>The crossbow is loaded.</effect>
    </abilitytrigger>
    <abilitycheck>
      <name>Fast Reload</name>
      <actiontype><ap2/></actiontype>
      <range><touch/></range>
      <keywords><black-powder/></keywords>
      <dc><dc9/></dc>
      <mastery>
	<any-success>Reload the gun during combat.  If successful the gun is reloaded during
	this minor action.  A gun can be reloaded without a check using a Standard Action.
	</any-success>
	<!-- <critsuccess></critsuccess> -->
	<!-- <critfail></critfail> -->
      </mastery>
      <fate> 
	<!-- <boon></boon> -->
	<indifferent>FIXME</indifferent>
	<!-- <bane></bane> -->
      </fate>
    </abilitycheck>
    <abilitycheck>
      <name>Repair</name>
      <actiontype><noncombat/></actiontype>
      <range><touch/></range>
      <keywords></keywords>
      <dc><dc13/></dc>
      <!-- <dmg></dmg> -->
      <mastery>
	<any-success>Make minor repairs and perform maintenance on the gun</any-success>
	<!-- <critsuccess></critsuccess> -->
	<!-- <critfail></critfail> -->
      </mastery>
      <fate>
	<!-- <boon></boon> -->
	<indifferent>FIXME</indifferent>
	<!-- <bane></bane> -->
      </fate>
    </abilitycheck>
    <prereqabilityrank>gun_shoot_1</prereqabilityrank>
    <spline><p x="0" y="30"/></spline>
    <abilitydescription>
      <p>
	The character needs to make this check to reload the gun
	during combat.  
      </p>

      <p>
	At rank 3 and above the character can make repairs to a gun
	out of combat on a successful check (presumably addressing damage
	caused by misfires).
      </p>      
    </abilitydescription>
  </ability>

  
  <ability>
    <abilitytitle>Sharp Shooter</abilitytitle>
    <abilityid>sharp_shooter</abilityid>
    <abilityranks from="1" to="5"/>
    <abilitycheck>
      <name>Attack</name>
      <actiontype><ap7/></actiontype>      <!-- Slower action type -->
      <xdef fname="gun_defaults" elem_name="range"/>      
      <xdef fname="gun_defaults" elem_name="dc"/>
      <mastery>
	<any-success>Weapon+Rank</any-success>
	<critsuccess>Deal 4×Damage</critsuccess>
	<righteoussuccess>Deal 3×Damage</righteoussuccess>
	<success>Deal Damage</success>
	<any-fail>Miss</any-fail>
	<critfail>Roll on the ranged consequence table</critfail>
      </mastery>      
      <xdef fname="gun_defaults" elem_name="fate"/>
    </abilitycheck>
    <prereqabilityrank>gun_shoot_2</prereqabilityrank>
    <spline><p x="60" y="30"/></spline>
    <abilitydescription>
      <p>
	The character has spent many hours working on improving the accuracy of
	their shots.  Players can choose to call a shot which gives them a 
	bonus to hit, but takes extra time to aim.
      </p>
    </abilitydescription>
  </ability>

  
  <ability>
    <abilitytitle>Gun Shoot</abilitytitle>
    <abilityid>gun_shoot</abilityid>
    <abilityranks untrained="-3" from="1" to="3"/>
    <abilitycheck>
      <name>Attack</name>
      <actiontype><ap3/></actiontype>
      <xdef fname="gun_defaults" elem_name="range"/>      
      <xdef fname="gun_defaults" elem_name="dc"/>      
      <mastery>
	<any-success>Weapon+Rank</any-success>
	<critsuccess>Deal 3×Damage</critsuccess>
	<righteoussuccess>Deal 2×Damage</righteoussuccess>
	<success>Deal Damage</success>
	<any-fail>Miss</any-fail>
	<critfail>Roll on the ranged consequence table</critfail>
      </mastery>
      <xdef fname="gun_defaults" elem_name="fate"/>
    </abilitycheck>
    <spline></spline>
    <abilitydescription>
      <p noindent="true">
        Characters equipped with a gun can shoot with it during combat
	doing weapon damage.  Any bane results in a gun jam.  A critical
	fail results in a small explosion (firer takes 1 damage).  A boon
	results in double damage.
      </p>
    </abilitydescription>
  </ability>
</abilitygroup>
