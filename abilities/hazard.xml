  <ability>
    <abilitytitle>Feat of Strength</abilitytitle>
    <abilityid>feet_of_strength</abilityid>
    <abilityranks from="1" to="5"/>    
    <abilityopposed> 
      <name>Opposed</name>
      <actiontype><gm-fiat/></actiontype>
      <range><touch/></range>
      <keywords><opposed/></keywords>
      <dc><dc11-plus-rank/></dc>
      <save><strength-save/></save>
      <mastery>
	<success>Unharmed</success>
	<fail>Failed.</fail>
	<critfail>Niggling injury.  -1 Mettle.</critfail>
      </mastery>
      <!-- <fate> -->
      <!-- 	<boon>Another way?  If this check fails the character can try again with advantage.</boon> -->
      <!-- 	<critfail>Niggling injury.  -1 Mettle.</critfail> -->
      <!-- </fate>       -->
    </abilityopposed>
    <spline></spline>
    <abilitydescription>
      <p noindent="true">
	The character wishes to perform a Feat of Strength, such as bending bars or lift gates, and
	moving or carrying heavy objects.
      </p>
    </abilitydescription>
  </ability>
  

  <ability>
    <abilitytitle>Drown</abilitytitle>
    <abilityid>drown</abilityid>
