      <dc><dc13-plus-rank/></dc>
      <save><endurance-save/></save>
      <mastery>
      <success>Swims</success>
      <fail>Check again next round with disadvantage.</fail>
      <critfail>Character is drowned.</critfail>
      </mastery>
    </abilityopposed>
    <spline></spline>
    <abilitydescription>
      <p noindent="true">
      </p>
    </abilitydescription>
