<?xml version="1.0" encoding="utf-8"?>
<abilitygroup>
  <abilitygroupinfo>
    <abilitygrouptitle>Hazards</abilitygrouptitle>
    <abilitygroupid><hazard/></abilitygroupid>
    <abilitygroupfamily><gm/></abilitygroupfamily>
    <abilitygroupdescription>
      <p>
	These abilities describe miscellaneous  Challenges
	or Hazards that	the PCs might have to face.
      </p>      
    </abilitygroupdescription>
    <dontdrawskilltree/>
    <enabled/>
  </abilitygroupinfo>

  <ability>
    <abilitytitle>Fall</abilitytitle>
    <abilityid>fall</abilityid>
    <abilityranks from="1" to="5"/>    
    <abilityopposed> 
      <name>Opposed</name>
      <actiontype><immediate/></actiontype>
      <range><self/></range>
      <keywords><aoe-emination/><opposed/></keywords>
      <dc><dc15-plus-rank/></dc>
      <save><luck-save/></save>
      <mastery>
	<critsuccess>Unharmed and find something useful.</critsuccess>
	<righteoussuccess>Unharmed</righteoussuccess>
	<success>Take Rank damage</success>
	<fail>Take d6×Rank damage</fail>
      </mastery>
    </abilityopposed>
    <spline></spline>
    <abilitydescription>
      <p noindent="true">
      </p>
    </abilitydescription>
  </ability>

