<?xml version="1.0" encoding="utf-8"?>
<abilitygroup>
  <abilitygroupinfo>
    <abilitygrouptitle>Hammer Abilities</abilitygrouptitle>
    <abilitygroupid><hammer/></abilitygroupid>
    <abilitygroupfamily><martial/></abilitygroupfamily>
    <keywords><heavy/><crushing/></keywords>
    <abilitygroupdescription>
      <p>
        Represents training the ability to use war hammers in combat.  This includes
	the use of two handed warhammers, single handed hammers and throwing hammers.
	Warhammers tend to be designed as armour piercing weapons.
      </p>
    </abilitygroupdescription>
    <enabled/>
  </abilitygroupinfo>
  

  <ability>
    <abilitytitle>Hammer Smash</abilitytitle>
    <abilityid>hammer_smash</abilityid>    
    <abilityranks from="1" to="4"/>
    <abilitycheck>
      <name>Hammer Smash</name>
      <checktype><melee-attack/></checktype>
      <apcost><free/></apcost>
      <range><reach/></range>
      <keywords>
	<hammer/><melee/><basic-attack/><physical-attack/><check/>
      </keywords>
      <counter><opponents-physical-defence/></counter>
      <critsuccess><default-attack-critical-success/></critsuccess>
      <righteoussuccess><default-attack-righteous-success/></righteoussuccess>  
      <success><default-attack-success/></success>
    </abilitycheck>
    <prereqabilityref id="hammer_strike" rank="2"/>
    <spline><p x="90" y="30"/></spline>
    <abilitydescription>
      <p>
        Characters equipped with a hammer can use the hammer to "smash" an
	opponent of the appropriate siuze hitting them and pushing them back.
      </p>
    </abilitydescription>
  </ability>


  <ability>
    <abilitytitle>Righteous Blow</abilitytitle>
    <abilityid>stunning_blow</abilityid>
    <abilityranks from="1" to="3"/>
    <abilityauxiliary>
      <name>Righteous Blow</name>      
      <!-- <critclass><melee/></critclass> -->
      <checktype><auxiliary/></checktype>
      <apcost><free/></apcost>
      <range><reach/></range>
      <keywords><hammer/><melee/><auxiliary/></keywords>
      <precondition>
	Righteous Success with the Hammer Strike Ability against an opponent of
	similar size or smaller.
      </precondition>
      <effect>
	Target is Stunned and Target takes an additional +Rank hit points damage.
      </effect>
    </abilityauxiliary>
    <prereqabilityref id="hammer_strike" rank="2"/>
    <spline><p x="-60" y="30"/></spline>
    <abilitydescription>
      <p>
	When the character makes a Hammer Strike with a righteous success the
	character may make a Righteous Blow attack as a free action. They make a
	check versus their opponents Agility. If they make a righteous success
	the opponent is stunned (loses their Move, Minor and Reaction for their
	next turn).
      </p>
    </abilitydescription>
  </ability>

  
  <ability>
    <abilitytitle>Hammer Strike</abilitytitle>
    <abilityid>hammer_strike</abilityid>
    <abilityranks untrained="0" from="1" to="4"/>
    <abilitycheck>
      <name>Melee Attack</name>
      <checktype><melee-attack/></checktype>
      <apcost><ap4/></apcost>
      <range><reach/></range>
      <keywords>
	<hammer/><melee/><basic-attack/><physical-attack/><check/>
      </keywords>
      <counter><opponents-physical-defence/></counter>
      <dmg>Weapon+Strength|Endurance</dmg>
      <critsuccess><default-attack-critical-success/></critsuccess>
      <!-- <critsuccess>Frog</critsuccess> -->
      <righteoussuccess><default-attack-righteous-success/></righteoussuccess>  
      <success><default-attack-success/></success>
    </abilitycheck>
    <spline></spline>
    <abilitydescription>
      <p noindent="true">
        Characters equipped with an Hammer can strike with it during combat
	doing weapon damage.
      </p>
    </abilitydescription>
  </ability>
</abilitygroup>
