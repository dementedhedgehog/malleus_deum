<?xml version="1.0" encoding="utf-8"?>
<abilitygroup>
  <abilitygroupinfo>
    <abilitygrouptitle>Dagger Abilities</abilitygrouptitle>
    <abilitygroupid><dagger/></abilitygroupid>
    <abilitygroupfamily><martial/></abilitygroupfamily>
    <abilitygroupdescription>
      <p>
        Represents training the ability to use daggers, stillettos
	rondels.
      </p>
    </abilitygroupdescription>
    <enabled/>
  </abilitygroupinfo>

  
  <ability>
    <abilitytitle>Dagger Riposte</abilitytitle>
    <abilityid>riposte</abilityid>    
    <abilityranks untrained="-3" from="1" to="5"/>
    <abilityauxiliary>
      <name>Talent</name>
      <checktype><auxiliary/></checktype>
      <apcost><free/></apcost>
      <range><reach/></range>
      <keywords><melee/><physical-attack/><auxiliary/></keywords>
      <precondition>
	Character makes a righteous attack with their main weapon.
      </precondition>
      <effect>
	Character may make a Dagger Strike attack with a dagger in their
	off-hand.
      </effect>
    </abilityauxiliary>
    <prereqabilityref id="dagger_strike" rank="2"/>
    <prereqattr><speed>3</speed><agility>3</agility></prereqattr>
    <spline><p x="75" y="30"/></spline>
    <abilitydescription>
      <p>
	The character is dual wielding, holding the dagger in their off hand.
	They attack with both weapons.  Attack with the dagger, if successful
	they can take an extra standard action attack with their primary weapon.
      </p>
    </abilitydescription>
  </ability>

  
  <ability>
    <abilitytitle>Dagger Strike</abilitytitle>
    <abilityid>dagger_strike</abilityid>    
    <abilityranks untrained="0" from="1" to="5"/>
    <abilitycheck>
      <name></name> 
     <checktype><melee-attack/></checktype>
      <apcost><ap3/></apcost>
      <range><reach/></range>
      <keywords><melee/><physical-attack/><check/></keywords>
      <counter><opponents-physical-defence/></counter>
      <dmg>Weapon+Speed|Agility</dmg>
      <critsuccess><default-attack-critical-success/></critsuccess>
      <righteoussuccess><default-attack-righteous-success/></righteoussuccess>  
      <success><default-attack-success/></success>      
    </abilitycheck>
    <spline></spline>
    <abilitydescription>
      <p noindent="true">
        Characters equipped with a dagger can strike with it during combat
	doing weapon damage.
      </p>
    </abilitydescription>
  </ability>


  <ability>
    <abilitytitle>Throw Dagger</abilitytitle>
    <abilityid>dagger_throw</abilityid>
    <abilityranks untrained="-3" from="1" to="5"/>
    <abilitycheck>
      <name></name>
      <checktype><missile-attack/></checktype>
      <apcost><ap2/></apcost>
      <range><ranged-short/></range>
      <keywords><missile/><check/></keywords>
      <counter><opponents-physical-defence/></counter>
      <critsuccess><default-attack-critical-success/></critsuccess>
      <righteoussuccess><default-attack-righteous-success/></righteoussuccess>  
      <success><default-attack-success/></success>      
    </abilitycheck>
    <prereqabilityref id="dagger_strike" rank="1"/>
    <spline><p x="-75" y="30"/></spline> 
    <abilitydescription>
      <p>
        Characters equipped with a dagger can throw the
	dagger at an opponent.  FIXME crits/checktype?  (advantage over "throw
	object" is attack extra damage?)
      </p>
    </abilitydescription>
  </ability>  
</abilitygroup>
