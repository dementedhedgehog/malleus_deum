<?xml version="1.0" encoding="utf-8"?>
<abilitygroup>
  <abilitygroupinfo>
    <abilitygrouptitle>Dagger Proficiency</abilitygrouptitle>
    <abilitygroupid><dagger/></abilitygroupid>
    <abilitygroupfamily><martial/></abilitygroupfamily>
    <abilitygroupdescription>
      <p>
        Represents training the ability to use daggers, stillettos
	rondels.
      </p>
    </abilitygroupdescription>
    <enabled/>
  </abilitygroupinfo>

  
  <ability>
    <abilitytitle>Dagger Riposte</abilitytitle>
    <abilityid>riposte</abilityid>    
    <abilityranks untrained="-3" from="1" to="5"/>
    <abilitytrigger>
      <name>Trigger</name>
      <actiontype><free/></actiontype>
      <range><melee/></range>
      <keywords><melee/></keywords>
      <precondition>Character makes a successful attack with their main weapon.</precondition>
      <effect>Character may make a Dagger Strike attack with a dagger in their off-hand.</effect>
    </abilitytrigger>
    <prereqabilityrank>dagger_strike_2</prereqabilityrank>
    <prereqattr><speed>13</speed><agility>13</agility></prereqattr>
    <spline><p x="75" y="30"/></spline>
    <abilitydescription>
      <p>
	The character is dual wielding, holding the dagger in their off hand.
	They attack with both weapons.  Attack with the dagger, if successful
	they can take an extra standard action attack with their primary weapon.
      </p>
    </abilitydescription>
  </ability>
  

  <ability>
    <abilitytitle>Dagger Strike</abilitytitle>
    <abilityid>dagger_strike</abilityid>    
    <abilityranks untrained="0" from="1" to="5"/>
    <abilityattack>
      <name>Check</name>
      <actiontype><ap3/></actiontype>
      <range><melee/></range>
      <keywords><melee/></keywords>
      <dc><opponents-defend/></dc>
      <dmg>Weapon+Speed|Agility</dmg>
      <xdef fname="mastery_melee_defaults" elem_name="mastery"/>            
      <xdef fname="fate_melee_defaults" elem_name="fate"/>            
    </abilityattack>
    <spline></spline>
    <abilitydescription>
      <p noindent="true">
        Characters equipped with a dagger can strike with it during combat
	doing weapon damage.
      </p>
    </abilitydescription>
  </ability>


  <ability>
    <abilitytitle>Throw Dagger</abilitytitle>
    <abilityid>dagger_throw</abilityid>
    <abilityranks untrained="-3" from="1" to="5"/>
    <abilitycheck>
      <name>Check</name>
      <actiontype><ap2/></actiontype>
      <range><ranged-short/></range>
      <keywords><missile/></keywords>
      <dc><opponents-defend/></dc>
      <mastery>
	<any-success>Weapon</any-success>  
	<critsuccess>Triple Damage</critsuccess>
	<righteoussuccess>Double Damage</righteoussuccess>
	<success>Θ</success>
	<fail>Θ</fail>
	<grimfail>Θ</grimfail>
	<critfail>Make a Dagger Break Check. On a fail the dagger is lost or broken.</critfail>	
      </mastery>
      <fate>
	<blessed>Fast: This is a free action.</blessed>
	<bane>Fumble: Lose remaining actions this round</bane>
	<damned>Roll on Misfortune Table</damned>
      </fate>
    </abilitycheck>
    <prereqabilityrank>dagger_strike_1</prereqabilityrank>
    <spline><p x="-75" y="30"/></spline> 
    <abilitydescription>
      <p>
        Characters equipped with a dagger can throw the
	dagger at an opponent.
      </p>
    </abilitydescription>
  </ability>  
</abilitygroup>
