<?xml version="1.0" encoding="utf-8"?>
<abilitygroup>
  <abilitygroupinfo>
    <abilitygrouptitle>Crossbow Proficiency</abilitygrouptitle>
    <abilitygroupid><crossbow/></abilitygroupid>
    <abilitygroupfamily><martial/></abilitygroupfamily>
    <abilitygroupdescription>
      <p>
        Represents training the ability to use of the bow and arrow.  This
	includes at higher lvels the use of the long bow.
      </p>
    </abilitygroupdescription>
    <enabled/>
  </abilitygroupinfo>
  

  <ability>
    <abilitytitle>Light Crossbow</abilitytitle>
    <abilityid>crossbow_shoot</abilityid>    
    <abilityranks untrained="-3" from="1" to="4"/>
    <abilityattack>
      <name>Attack</name>
      <actiontype><ap4/></actiontype>
      <xdef fname="crossbow_defaults" elem_name="range"/>      
      <dc><opponents-defend/></dc>
      <dmg>Weapon</dmg>
      <xdef fname="mastery_melee_defaults" elem_name="mastery"/>            
      <xdef fname="fate_melee_defaults" elem_name="fate"/>            
    </abilityattack>
    <spline></spline>
    <abilitydescription>
      <p noindent="true">
        Characters equipped with a <emph>Light Crossbow</emph> can shoot it during combat
	doing weapon damage.  It takes ap3 to reload a light crossbow, ap4 to reload a
	heavy crossbow.
      </p>
    </abilitydescription>
  </ability>


  <ability>
    <abilitytitle>Reload</abilitytitle>
    <abilityid>fast_loader</abilityid>    
    <abilityranks from="0" to="4"/>
    <abilitycheck>
      <name>Fast Reload</name>
      <actiontype><ap2/></actiontype>
      <range><self/></range>
      <dc><dc11/></dc>
      <mastery>
	<critsuccess>Reload takes 1ap</critsuccess>
	<righteoussuccess>Reload takes 2ap</righteoussuccess>
	<success>Reload takes 3ap</success>
	<fail>Reload takes 4ap</fail>
	<grimfail>Reload takes 7ap</grimfail>
      </mastery>
      <xdef fname="fate_melee_defaults" elem_name="fate"/>            
    </abilitycheck>
    <prereqabilityrank>crossbow_shoot_2</prereqabilityrank>
    <spline><p x="-90" y="30"/></spline>
    <abilitydescription>
      <p>
	The character has spent a long time practicing reloading a crossbows.
	They can check to reload their crossbow and fire in the same
	round (usually it takes a whole round to reload).  If they fail they
	spend the round reloading instead.
      </p>
    </abilitydescription>
  </ability>


  <!-- FIXME add an accurate shot -->
  
  <ability>
    <abilitytitle>Heavy Cross Bow</abilitytitle>
    <abilityid>heavy</abilityid>
    <abilityranks untrained="-3" from="1" to="1"/>
    <keywords></keywords>
    <prereqabilityrank>crossbow_shoot_2</prereqabilityrank>
    <spline><p x="90" y="30"/></spline>
    <abilitydescription>
      <p>
	Character has trained in the use of the heavy crossbow.  Characters
	with this ability can use the Light Crossbow Shoot ability with Heavy
	Crossbows.  Heavy crossbows are slow to reload and take a full turn
	to reload.
      </p>
    </abilitydescription>
  </ability>  
</abilitygroup>
