<?xml version="1.0" encoding="utf-8"?>
<abilitygroup>
  <abilitygroupinfo>
    <abilitygrouptitle>Crossbow Abilities</abilitygrouptitle>
    <abilitygroupid><crossbow/></abilitygroupid>
    <abilitygroupfamily><martial/></abilitygroupfamily>
    <abilitygroupdescription>
      <p>
        Represents training the ability to use of the bow and arrow.  This
	includes at higher lvels the use of the long bow.
      </p>
    </abilitygroupdescription>
    <enabled/>
  </abilitygroupinfo>
  
  <ability>
    <abilitytitle>Light Crossbow</abilitytitle>
    <abilityid>crossbow_shoot</abilityid>    
    <abilityranks untrained="-3" from="1" to="4"/>
    <action>
      
      <name>Missile-Attack</name> 
      <opposing-action><physical-defence/></opposing-action>
      <critclass><missile-attack/></critclass>
      <cost><ap2/></cost>
      <range><default-crossbow-range/></range>
      <keywords>
	<crossbow/><physical-attack/><basic-attack/><missile/><check/>
      </keywords>
      <dmg>Weapon</dmg>
      <critsuccess><default-attack-critical-success/></critsuccess>
      <righteoussuccess><default-attack-righteous-success/></righteoussuccess>  
      <success><default-attack-success/></success>
    </action>

    <action>
      
      <name>Reload</name>
      <critclass><auxiliary/></critclass>
      <cost><ap3/></cost>
      <range><reach/></range>
      <keywords><auxiliary/></keywords>
      <precondition>Armed with an empty crossbow.</precondition>
      <effect>Reloads the crossbow.</effect>
    </action>
    <spline></spline>
    <abilitydescription>
      <p noindent="true">
        Characters equipped with a <emph>Light Crossbow</emph> can shoot it
	during combat doing weapon damage.  Crossbows have to be reloaded
	as a separate action.
      </p>
    </abilitydescription>
  </ability>

  <ability>
    <abilitytitle>Deadshot</abilitytitle>
    <abilityid>crossbow_deadshot</abilityid>    
    <abilityranks untrained="-3" from="1" to="4"/>
    <action>
      <name>Missile-Attack</name> 
      <opposing-action><physical-defence/></opposing-action>
      <critclass><missile-attack/></critclass>
      <cost><ap5/></cost>
      <range><default-crossbow-range/></range>
      <keywords>
	<crossbow/><physical-attack/><basic-attack/><missile/><check/>
      </keywords>
      <dmg>Weapon</dmg>
      <critsuccess><default-attack-critical-success/></critsuccess>
      <righteoussuccess><default-attack-righteous-success/></righteoussuccess>
      <success><default-attack-success/></success>
      <effect>Attacks with advantage.</effect>
    </action>
    <prereqabilityref id="crossbow_shoot" rank="2"/>
    <spline><p x="90" y="30"/></spline>
    <abilitydescription>
      <p noindent="true">
        Characters equipped with a <emph>Light Crossbow</emph> can shoot it
	during combat doing weapon damage.  
      </p>
    </abilitydescription>
  </ability>
  

  <ability>
    <abilitytitle>Reload</abilitytitle>
    <abilityid>fast_loader</abilityid>    
    <abilityranks untrained="-3" from="1" to="4"/>
    <action>
      <name>Trial</name>
      <opposing-action><sv11/></opposing-action>      
      <critclass><test/></critclass>
      <cost><ap2/></cost>
      <range><self/></range>
      <keywords><crossbow/><missile/><check/></keywords>
      <critsuccess>Reload takes 1ap</critsuccess>
      <righteoussuccess>Reload takes 2ap</righteoussuccess>
      <success>Reload takes 3ap</success>
      <fail>Reload takes 4ap</fail>
      <grimfail>Reload takes 7ap</grimfail>      
    </action>
    <prereqabilityref id="crossbow_shoot" rank="2"/>
    <spline><p x="-90" y="30"/></spline>
    <abilitydescription>
      <p>
	The character has spent a long time practicing reloading a crossbows.
	They can check to reload their crossbow and fire in the same
	round (usually it takes a whole round to reload).  If they fail they
	spend the round reloading instead.
      </p>
    </abilitydescription>
  </ability>
  
  <ability>
    <abilitytitle>Heavy Cross Bow</abilitytitle>
    <abilityid>heavy</abilityid>
    <abilityranks untrained="-3" from="1" to="1"/>
    <keywords></keywords>
    <prereqabilityref id="crossbow_shoot" rank="2"/>
    <spline><p x="0" y="30"/></spline>
    <abilitydescription>
      <p>
	Character has trained in the use of the heavy crossbows in any
	ability that uses light crossbows.
      </p>
    </abilitydescription>
  </ability>  
</abilitygroup>
