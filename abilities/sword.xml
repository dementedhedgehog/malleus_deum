<?xml version="1.0" encoding="utf-8"?>
<abilitygroup>
  <abilitygroupinfo>
    <abilitygrouptitle>Sword Proficiency</abilitygrouptitle>
    <abilitygroupid><sword/></abilitygroupid>
    <abilitygroupfamily><martial/></abilitygroupfamily>
    <abilitygroupdescription>
      <p>
        Represents training the ability to use swords in combat.  This includes
	the use of two handed swords.
      </p>      
    </abilitygroupdescription>
    <enabled/>
  </abilitygroupinfo>

  
  <ability>
    <abilitytitle>Daring Thrust</abilitytitle>
    <abilityid>daring_thrust</abilityid>    
    <abilityranks from="1" to="3"/>
    <abilitytrigger>
      <name>Trigger</name>
      <actiontype><reaction/></actiontype>
      <range><melee/></range>
      <keywords><trigger/></keywords>
      <precondition>Successfully defend against a melee attack.</precondition>
      <effect>May make a Sword Retort attack as a reaction.</effect>
    </abilitytrigger>
    <prereqabilityrank>sword_strike_2</prereqabilityrank>
    <spline><p x="15" y="30"/></spline>
    <abilitydescription>
      <p>
      </p>
    </abilitydescription>
  </ability>

  
  <ability>
    <abilitytitle>Follow Through</abilitytitle>
    <abilityid>follow_through</abilityid>    
    <abilityranks from="1" to="2"/>
    <abilitytrigger>
      <name>Attack</name>
      <actiontype><ap2/></actiontype>
      <range><melee/></range>
      <keywords><trigger/></keywords>
      <precondition>Hit with a melee attack.</precondition>
      <effect>Make a Sword Retort attack on the first, or second adjacent, opponent.</effect>
    </abilitytrigger>
    <prereqabilityrank>sword_strike_2</prereqabilityrank>
    <spline><p x="15" y="30"/></spline>
    <abilitydescription>
      <p>
	The character hits an opponent with a melee attack.  If successful
	they can make a Sword Strike check to a second adjacent opponent.
      </p>
    </abilitydescription>
  </ability>

  
  <ability>
    <abilitytitle>Mighty Blow</abilitytitle>
    <abilityid>mighty_blow</abilityid>    
    <abilityranks from="1" to="3"/>
    <abilityattack>
      <name>Attack</name>
      <actiontype><ap7/></actiontype>
      <range><melee/></range>
      <keywords><mettlepool/></keywords>      
      <dc><dc11/></dc>
      <dmg>Weapon+Rank+Strength|Speed</dmg>
      <mastery>
	<critsuccess>4×Dmg</critsuccess>
	<righteoussuccess>3×Dmg</righteoussuccess>
	<success>Dmg</success>
	<fail>No Effect</fail>
      </mastery>
      <xdef fname="fate_melee_reaction_defaults" elem_name="fate"/>                  
    </abilityattack>
    <prereqabilityrank>sword_strike_3</prereqabilityrank>
    <spline><p x="90" y="30"/></spline>
    <abilitydescription>
      <p noindent="true">
        Characters equipped with a Sword can strike with it using enormous force
	during combat.  
      </p>
    </abilitydescription>
  </ability>

  
  <ability>
    <abilitytitle>Sword Disarm</abilitytitle>
    <abilityid>disarm</abilityid>
    <abilityranks from="1" to="3"/>
    <abilitycheck>
      <name>Check</name>
      <actiontype><ap3/></actiontype>
      <range><melee/></range>
      <dc><opponents-speed/></dc>
      <mastery>
	<any-success>Opponent disarmed</any-success>
      </mastery>
      <xdef fname="fate_melee_reaction_defaults" elem_name="fate"/>
    </abilitycheck>
    <prereqabilityrank>sword_strike_2</prereqabilityrank>	
    <spline><p x="-80" y="30"/></spline>
    <abilitydescription>
      <p>
	The character attempts to disarm their opponent.  If
	successful the opponent is disarmed. 
      </p>
    </abilitydescription>
  </ability>  

  
  <ability>
    <abilitytitle>Sword Feint</abilitytitle>
    <abilityid>feint</abilityid>
    <abilityranks from="1" to="3"/>
    <abilitycheck>
      <name>Check</name>
      <actiontype><reaction/></actiontype>      
      <range><melee/></range>
      <dc><opponents-agility/></dc>
      <mastery>
	<any-success>Character acts before target.</any-success>
      </mastery>
      <xdef fname="fate_melee_reaction_defaults" elem_name="fate"/>      
    </abilitycheck>
    <prereqabilityrank>sword_strike_2</prereqabilityrank>
    <spline><p x="15" y="30"/></spline>
    <abilitydescription>
      <p>
	FIXME: after they're hit they've likely used their reaction!!
	The character makes an opposed check after an opponent successfully attacks
	them with a melee weapon. The character can attempt If they are successful
	they act before their opponent.  This action cannot be taken if surprised.
      </p>
    </abilitydescription>
  </ability>
  

  <ability>
    <abilitytitle>Sword Retort</abilitytitle>
    <abilityid>sword_retort</abilityid>    
    <abilityranks untrained="0" from="1" to="6"/>
    <abilityattack>
      <name>Attack</name>   
      <actiontype><ap3/></actiontype>
      <range><melee/></range>
      <keywords><basic-attack/></keywords>
      <dc><opponents-defend/></dc>
      <dmg>Weapon+Rank+Strength|Speed</dmg>
      <xdef fname="mastery_melee_defaults" elem_name="mastery"/>            
      <xdef fname="pool_cost_1" elem_name="fate"/>            
    </abilityattack>
    <spline></spline>
    <abilitydescription>
      <p noindent="true">	
        Characters equipped with a Sword can counter strike with it during combat.
	This ability is usually triggered by other abilities.
      </p>
    </abilitydescription>
  </ability>

  
  <ability>
    <abilitytitle>Sword Strike</abilitytitle>
    <abilityid>sword_strike</abilityid>    
    <abilityranks untrained="0" from="1" to="6"/>
    <abilityattack>
      <name>Attack</name>   
      <actiontype><ap4/></actiontype>
      <range><melee/></range>
      <keywords><basic-attack/></keywords>
      <dc><opponents-defend/></dc>
      <dmg>Weapon+Rank+Strength|Speed</dmg>
      <xdef fname="mastery_melee_defaults" elem_name="mastery"/>            
      <xdef fname="pool_cost_1" elem_name="fate"/>
    </abilityattack>
    <spline></spline>
    <abilitydescription>
      <p noindent="true">
        Characters equipped with a Sword can strike with it during
	combat doing weapon damage.
      </p>
    </abilitydescription>
  </ability>
</abilitygroup>
