<?xml version="1.0" encoding="utf-8"?>
<abilitygroup>
  <abilitygroupinfo>
    <abilitygrouptitle>Polearm/Spears/Staff Proficiency</abilitygrouptitle>
    <abilitygroupid><polearm/></abilitygroupid>
    <abilitygroupfamily><martial/></abilitygroupfamily>
    <abilitygroupdescription>
      <p>
        These abilities represent training in the use of spears, staves, 
	halberds, bill hooks, glaives and other pole-arms in combat.  Note that
	some abilities here cannot be used with some weapons, <eg/> Polearm Hook
	requires a hook on the end of the pole to catch so cannot be used with a
	spear or a staff. 
      </p>
    </abilitygroupdescription>
    <enabled/>
  </abilitygroupinfo>


  <ability>
    <abilitytitle>Polearm Hook</abilitytitle>
    <abilityid>polearm_hook</abilityid>    
    <abilityranks from="1" to="4"/>
    <abilitycheck>
      <name>Attack</name>
      <actiontype><free/></actiontype>
      <range><melee/></range>
      <precondition>Hit an opponent with a boon</precondition>
      <dc><opponents-strength/></dc>
      <mastery>
	<critsuccess>Target drops item, weapon or shield.  Attacker chooses.</critsuccess>
	<success>Target drops random item, weapon or shield</success>
      </mastery>
      <xdef fname="fate_melee_defaults" elem_name="fate"/>            
    </abilitycheck>
    <prereqabilityrank>polearm_strike_1</prereqabilityrank>    
    <spline><p x="90" y="30"/></spline>
    <abilitydescription>
      <p>
        Characters equipped with a polearm, but <bold>not a spear or staff</bold>, can
	use the hooked edge of this weapon to attempt to disarm an opponent
	or remove their shield.
      </p>
      <p>
	If the character successfuly hits the attacker with a boon, they can make a check 
	against their opponents Strength.  If successful the defender drops their weapon/shield.
      </p>
    </abilitydescription>
  </ability>
  

  <ability>
    <abilitytitle>Polearm/Staff/Spear Strike</abilitytitle>
    <abilityid>polearm_strike</abilityid>
    <abilityranks untrained="0" from="1" to="4"/>
    <abilityattack>
      <name>Attack</name>
      <actiontype><ap4/></actiontype>
      <range><melee/></range>
      <keywords><attack/></keywords>
      <dc><opponents-defend/></dc>
      <dmg>Weapon+Rank+Speed|Strength</dmg>
      <xdef fname="mastery_melee_defaults" elem_name="mastery"/>      
      <xdef fname="fate_melee_defaults" elem_name="fate"/>      
    </abilityattack>
    <spline></spline>
    <abilitydescription>
      <p noindent="true">
        Characters equipped with a spear, staff or polearm can strike with
	it during combat doing weapon damage.
      </p>
    </abilitydescription>
  </ability>  

  
  <ability>
    <abilitytitle>Brace for Charge</abilitytitle>
    <abilityid>polearm_brace</abilityid>    
    <abilityranks from="1" to="4"/>
    <abilityattack>
      <name>Brace</name>
      <actiontype><reaction/></actiontype>
      <range><melee/></range>
      <precondition>An opponent charges the character or an adjacent character</precondition>
      <dc><opponents-defend/></dc>
      <dmg>Weapon+Rank+Speed|Strength</dmg>
      <mastery>
	<critsuccess>4×Dmg</critsuccess>
	<righteoussuccess>3×Damage</righteoussuccess>
	<success>2×Dmg</success>
	<fail>No Effect</fail>
	<!-- <grimfail>Θ</grimfail> -->
	<critfail>Roll on the melee consequence table</critfail>
      </mastery>
      <xdef fname="fate_melee_reaction_defaults" elem_name="fate"/>      
    </abilityattack>
    <prereqabilityrank>polearm_strike_2</prereqabilityrank>
    <spline><p x="-75" y="30"/></spline>
    <abilitydescription>
      <p>
        Characters equipped with a spear or polearm can brace against
	a charge striking first and doing extra damage.  To use this
	the attack must be directed at an opponent that is Charging
	in the direction of the character.
      </p>
    </abilitydescription>
  </ability>


  <ability>
    <abilitytitle>Circle of Death</abilitytitle>
    <abilityid>circle_of_death</abilityid>
    <abilityranks from="1" to="4"/>
    <abilitytrigger>
      <name>Attack</name>
      <actiontype><ap4/></actiontype>
      <range><melee/></range>
      <keywords></keywords>
      <precondition>Opponents moves into reach anytime before his next reaction.</precondition>
      <effect>Character gets a free Fend reaction.</effect>
    </abilitytrigger>
    <prereqabilityrank>polearm_strike_1</prereqabilityrank>
    <spline><p x="-60" y="30"/></spline> 
    <abilitydescription>
      <p>
	The character swings their weapon in large arcs keeping foes at bay.
	Note that this ability requires a reasonable amount of space to swing the
	weapon.  
      </p>
    </abilitydescription>
  </ability>
  

  <ability>
    <abilitytitle>Fend</abilitytitle>
    <abilityid>fend</abilityid>    
    <abilityranks from="1" to="4"/>
    <abilityattack>
      <name>Attack</name>
      <actiontype><reaction/></actiontype>
      <range><melee/></range>
      <precondition>Opponents moves into reach.</precondition>      
      <dc><opponents-willpower/></dc>
      <dmg>Weapon+Rank+Speed|Strength</dmg>
      <mastery>
	<any-success>Opponent may not move into melee</any-success>
	<critsuccess>2×Dmg</critsuccess>
	<righteoussuccess>Dmg</righteoussuccess>
      </mastery>
      <xdef fname="fate_melee_reaction_defaults" elem_name="fate"/>      
    </abilityattack>
    <prereqabilityrank>polearm_strike_2</prereqabilityrank>
    <spline><p x="-30" y="75"/></spline>
    <abilitydescription>
      <p>
      </p>
    </abilitydescription>
  </ability>


