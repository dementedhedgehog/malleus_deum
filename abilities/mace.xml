<?xml version="1.0" encoding="utf-8"?>
<abilitygroup>
  <abilitygroupinfo>
    <abilitygrouptitle>Mace Abilities</abilitygrouptitle>
    <abilitygroupid><mace/></abilitygroupid>
    <abilitygroupfamily><martial/></abilitygroupfamily>
    <abilitygroupdescription>
      <p>
        Represents training the ability to use maces, clubs, flails,
	morning stars, virges, and improvised club-like weapons in combat.
      </p>
    </abilitygroupdescription>
    <enabled/>
  </abilitygroupinfo>
  

  <ability>
    <abilitytitle>Mace Smash</abilitytitle>
    <abilityid>mace_smash</abilityid>
    <abilityranks from="1" to="3"/>
    <abilitycheck>
      <name>Mace Smash</name>
      <checktype><melee-attack/></checktype>                
      <apcost><ap4/></apcost>
      <range><reach/></range>
      <keywords><physical-attack/><check/></keywords>
      <precondition>
	Fighting in melee against an opponent holding a weapon or shield
      </precondition>
      <counter><opponents-physical-defence/></counter>      
      <dmg>Weapon+Strength|Will</dmg>            
      <righteoussuccess>
	Make a break test against your opponents weapon or shield.
      </righteoussuccess>
    </abilitycheck>
    <prereqabilityref id="mace_strike" rank="2"/>
    <spline><p x="75" y="30"/></spline>
    <abilitydescription>
      <p>
        Characters equipped with a mace or similar weapon can attempt
	to destroy an opponents weapon or shield. If the attack is
	successful an opposed Strength check is made. If the opponent
	fails they drop their weapon or shield.
      </p>	
    </abilitydescription>
  </ability>

  
  <ability>
    <abilitytitle>Mace Strike</abilitytitle>
    <abilityid>mace_strike</abilityid>
    <abilityranks untrained="0" from="1" to="3"/>
    <abilitycheck>
      <name>Attack</name>
      <checktype><melee-attack/></checktype>                
      <apcost><ap3/></apcost>
      <range><reach/></range>
      <keywords><physical-attack/><check/></keywords>
      <counter><opponents-physical-defence/></counter>
      <dmg>Weapon+Strength|Will</dmg>
      <critsuccess><default-attack-critical-success/></critsuccess>
      <righteoussuccess><default-attack-righteous-success/></righteoussuccess>  
      <success><default-attack-success/></success>      
    </abilitycheck>
    <spline></spline>
    <abilitydescription>
      <p noindent="true">
        Characters equipped with a Mace or similar weapon can strike
	with it during combat doing weapon damage.
      </p>
    </abilitydescription>
  </ability>


  <ability>
    <abilitytitle>Mace Wild Swing</abilitytitle>
    <abilityid>wild_swing</abilityid>
    <abilityranks from="1" to="3"/>
    <abilitycheck>
      <name>Stand Firm</name>
      <checktype><melee-attack/></checktype>                
      <apcost><ap3/></apcost>
      <range><reach/></range>
      <keywords><check/></keywords>
      <counter><sv11/></counter>
      <critsuccess>Grants three Wild Swings</critsuccess>
      <righteoussuccess>Grants two Wild Swings.</righteoussuccess>  
      <success>Grants one Wild Swing.</success>
    </abilitycheck>
    <abilitycheck>
      <name>Wild Swing</name>
      <checktype><melee-attack/></checktype>                
      <apcost><free-reaction/></apcost>
      <range><reach/></range>
      <keywords><check/></keywords>
      <counter><opponents-will-save/></counter>
      <success>Action fails</success>
    </abilitycheck>
    <prereqabilityref id="mace_strike" rank="1"/>
    <spline><p x="-75" y="30"/></spline>
    <abilitydescription>
      <p>
	The character swings the mace wildly keeping their opponents at bay.
	When attacked the character makes a free will check against the first
	opponent that attacks them in a round. If successful the opponent loses
	their attack, being unable to approach.  If the will check is not
	successful the character makes a free attack against the opponents
	defence before the opponents attack.
      </p>
    </abilitydescription>
  </ability>
</abilitygroup>
