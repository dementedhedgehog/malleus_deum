  <ability>
    <abilitytitle>Zarat's Doom «Disease»</abilitytitle>
    <!-- Fantasy Leprosy -->
    <abilityid>Zarats_doom</abilityid>
    <param-rank>1</param-rank>         
    <abilityranks from="0" to="7"/>    
    <keywords><antagonist/><disease/></keywords>
    <check>
      <name>Every 3rd character level</name>
      <reaction><endurance-save/></reaction>
      <critclass><disease/></critclass>
      <cost><free/></cost>
      <range><na/></range>
      <keywords><reaction/></keywords>
    </check>
    <stage>
      <name>Skin Patch</name>
      <description>
	A patch of skin becomes pale or red and loses any hair.
      </description>
    </stage>
    <stage>
      <name>Numbed Limbs</name>
      <description>
	Agility checks made with a shift down. Patches pale or red skin.
      </description>
    </stage>
    <stage>
      <name>Lions Face</name>
      <description>
	Lesions on the face give the character a distinctly diseased appearance.
	Two shifts down on all social actions. 	Agility checks made with a shift
	down. Patches pale or red skin.
      </description>
    </stage>
    <stage>
      <name>Blindness</name>
      <description>
	Character is blind.  Endurance checks and Agility checks made with two
	shifts down.  Social checks made with three shifts down.  Facial lesions
	and skin patches.
      </description>
    </stage>    
    <abilitydescription>
      <p>
	Zarat's Doom is passed down along cursed bloodlines.  It is not
	contagious in the usual sense.
      </p>
    </abilitydescription>
  </ability>  
