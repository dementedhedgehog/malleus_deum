  <ability>
    <abilitytitle>Aspect Check</abilitytitle>
    <abilityid>aspect</abilityid>
    <abilityranks from="1" to="5"/>
    <abilitycheck>
      <name>Check</name>
      <!-- <defaults>pool_cost_1</defaults> -->
      <actiontype><immediate/></actiontype>
      <range><na/></range>
      <keywords><mettlepool/></keywords>
      <effect>If this aspect dos not have the <emph>permanent</emph> keyword, and 
      ranks up to 5 or more after this check then the aspect should be re-evaluated.</effect>
      <dc><gm-fiat/></dc>
      <mastery>
	<any-success>Aspect is resisted.</any-success>
	<critsuccess>Increase Rank of this Aspect by 2</critsuccess>
	<righteoussuccess>Tenacious: Increase Rank of this Aspect by 1</righteoussuccess>
	<any-fail>Aspect is compelled.</any-fail>
	<grimfail>Recidivism: Decrease Rank by 1 (to a minimum of 0).</grimfail>
      </mastery>
      <fate>
	<blessed>Increase Rank of this Aspect by 1</blessed>
	<boon></boon>
	<indifferent>1 cost</indifferent>
	<bane>2 cost</bane>
	<damned>3 cost</damned>
      </fate>      
    </abilitycheck>
    <abilitydescription>
      <p>
        <indexentry>Luck Check</indexentry>
	Characters make a luck check to se
      </p>
    </abilitydescription>
  </ability>
  

