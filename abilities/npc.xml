    <param-rank>3</param-rank>
    <abilitycheck>
      <name>Opposed</name>
      <checktype><fixme/></checktype>
      <poolcost>1</poolcost>
      <apcost><ap4/></apcost>
      <range><ranged-short/></range>
      <keywords><aoe-emination/><mettlepool/><npc/><check/></keywords>
      <counter><opponents-mettle-save/></counter>
      <success>No effect</success>
      <fail>Target loses Rank mettle</fail>
      <grimfail>Target loses Rank+1 mettle</grimfail>
      <critfail>Target loses Rank+2 mettle</critfail>
