  <ability>
    <abilitytitle>Swarm</abilitytitle>
    <abilityid>swarm</abilityid>
    <abilityranks from="1" to="5"/>
    <!-- <abilitycheck> -->
    <!--   <actiontype><ap1/></actiontype> -->
    <!--   <!-\- <critsuccess></critsuccess> -\-> -->
    <!--   <!-\- <critfail></critfail> -\-> -->
    <!--   <!-\- <boon></boon> -\-> -->
    <!--   <!-\- <bane></bane> -\-> -->
