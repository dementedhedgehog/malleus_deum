  </ability>  

  
  <ability>
    <abilitytitle>Watch Out Sir!</abilitytitle>
    <abilityid>watch_out_sir</abilityid>
    <param-rank>3</param-rank>
    <abilitycheck>
      <name>Check</name>
      <checktype><auxiliary/></checktype>
      <apcost><reaction/></apcost>
      <range><reach/></range>
      <keywords>
	<check/><delegate-saves/>
      </keywords>
      <counter><opponents-luck-save/></counter>
    </abilitycheck>
    <spline></spline>
    <abilitydescription>
      <p noindent="true">
	The monster grabs one of his lesser comrades and uses them as
	a meat shield to protect him from one non-area of effect
	attack.  If the check is successful the meat shield takes all
	the damage from one attack.
      </p>
    </abilitydescription>
  </ability>  

  
  <ability>
    <abilitytitle>Web</abilitytitle>
    <abilityid>web</abilityid>
    <param-rank>3</param-rank>
    <abilitycheck>
      <name>Opposed</name>
      <checktype><missile-attack/></checktype>
      <apcost><ap1/></apcost>
      <range><ranged-short/></range>
      <keywords>
	<aoe-cone/><unparryable/><check/><everyone-saves/>
      </keywords>
      <counter><opponents-physical-defence/></counter>
      <fail>Slowed</fail>
      <grimfail>Petrified</grimfail>      
    </abilitycheck>
    <spline></spline>
    <abilitydescription>
      <p noindent="true">
	The monster can shoot a sticky web-like substance that slows
	and constrains the target.  Armour and Parry cannot be
	used to defend against Web.  If successful the target is
	slowed.
      </p>
    </abilitydescription>     
  </ability>  
</abilitygroup>
