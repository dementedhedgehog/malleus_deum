<?xml version="1.0" encoding="utf-8"?>
<abilitygroup>
  <abilitygroupinfo>
    <abilitygrouptitle>NPC/Monster Abilities</abilitygrouptitle>
    <abilitygroupid><npc/></abilitygroupid>
    <abilitygroupfamily><antag/></abilitygroupfamily>
    <abilitygroupdescription>
      <p>
	These abilities describe monsters special abilities.  Monster abilities
	can break some of the standard constraints on abilities as monsters do
	not have to level up, and we typically want their abilities to be simple
	and easy to run.
      </p>      
    </abilitygroupdescription>
    <dontdrawskilltree/>
    <enabled/>
  </abilitygroupinfo>


  <ability>
    <abilitytitle>Bite</abilitytitle>
    <abilityid>bite</abilityid>
    <param-dmg>4</param-dmg>
    <param-rank>3</param-rank>
    <abilitycheck> 
      <name>Opposed</name> 
      <checktype><melee-attack/></checktype>
      <apcost><ap3/></apcost>
      <range><touch/></range>
      <keywords><melee/><check/></keywords>
      <counter><opponents-physical-defence/></counter>
      <dmg><param-dmg/></dmg>
      <any-fail><param-dmg/></any-fail>
    </abilitycheck>
    <spline></spline>
    <abilitydescription>
      <p noindent="true">
	The creature has a bite.
      </p>
    </abilitydescription>
  </ability>

  
  <ability>
    <abilitytitle>Blood Rage</abilitytitle>
    <abilityid>blood_rage</abilityid>
    <abilityauxiliary> 
      <name>Rage</name> 
      <checktype><auxiliary/></checktype>
      <apcost><free-reaction/></apcost>
      <range><self/></range>
      <keywords><auxiliary/></keywords>
      <precondition>Monster becomes bloodied.</precondition>
      <effect>Immediately makes a melee counter attack - if possible</effect>
    </abilityauxiliary>    
    <spline></spline>
    <abilitydescription>
      <p noindent="true">
	When bloodied the monster rages using this ability to attack a
	second time in melee.
      </p>
    </abilitydescription>
  </ability>

  
  <ability>
    <abilitytitle>Claw</abilitytitle>
    <abilityid>claw</abilityid>
    <param-dmg>4</param-dmg>    
    <param-rank>3</param-rank>
    <abilitycheck>
      <name>Opposed</name>
      <checktype><melee-attack/></checktype>
      <apcost><ap2/></apcost>
      <range><reach/></range>
      <keywords><check/><melee/></keywords>
      <counter><opponents-physical-defence/></counter>
      <any-fail>param-dmg</any-fail>
    </abilitycheck>
    <spline></spline>
    <abilitydescription>
      <p noindent="true">
	<!-- Claws are an attack that are particularly effective against -->
	<!-- Claws get an +Rank to hit against Block or Armour Defences. -->
      </p>
    </abilitydescription>
  </ability>

  
  <ability>
    <abilitytitle>Countless Bites</abilitytitle>
    <abilityid>countless_bites</abilityid>
    <param-dmg>4</param-dmg>    
    <param-rank>3</param-rank>
    <abilitycheck>      
      <name>Opposed</name>
      <checktype><melee-attack/></checktype>
      <apcost><ap3/></apcost>
      <range><reach/></range>
      <keywords>
	<npc/><check/><melee/><unblockable/><undodgeable/><unparryable/>
      </keywords>
      <counter><opponents-physical-defence/></counter>
      <any-success>1+Rank Damage</any-success>
      <fail>Deal Damage</fail>
      <grimfail>Deal 2×Damage</grimfail>
      <critfail>Deal 3×Damage</critfail>      
    </abilitycheck>
    <spline></spline>
    <abilitydescription>
      <p noindent="true">
	The monster makes dozens of attacks per round.  No to-hit roll is
	required.  No block or dodge saves apply.  The monster does a fixed
	amount of damage to each character, friend or foe, adjacent to it at
	the end of the monsters turn. The monster makes an automatic attack when
	making an opportunity attack.  Adjacent characters are Dazed and
	Distracted.
      </p>

      <p>
	On the first round characters have to make a mettle check to ignore
	the bites or lose their turn or flee.
      </p>
    </abilitydescription>
  </ability>

  
  <ability>
    <abilitytitle>Death Blow</abilitytitle>
    <abilityid>death_blow</abilityid>
    <param-dmg>4</param-dmg>    
    <param-rank>3</param-rank>
    <abilityauxiliary>
      <name>Trigger</name>
      <checktype><auxiliary/></checktype>
      <apcost><free/></apcost>
      <range><na/></range>
      <keywords><auxiliary/></keywords>
      <precondition>When the character would go Down</precondition>
      <effect>The character gets one more melee attack</effect>
    </abilityauxiliary>
    <spline></spline>
    <abilitydescription>
      <p noindent="true">
	When the character goes down they get one last additional attack.
      </p>
    </abilitydescription>
  </ability>
  

  <!-- FIXME THIS SHOULD BE A SAVE? -->
  <ability>
    <abilitytitle>Demon Instability</abilitytitle>
    <abilityid>demon_instability</abilityid>
    <abilitycheck>
      <name>Check</name>
      <checktype><fixme/></checktype>
      <poolcost>2</poolcost>
      <apcost><free/></apcost>
      <range><na/></range>
      <keywords><mettlepool/><check/><delegate-saves/></keywords>
      <precondition>When this creature is hit for 10 or more damage</precondition>
      <counter><opponents-luck-save/></counter>
      <any-fail>
	The demon loses its link to its simulacrum in this plane. The simularcrum
	is destroyed.
      </any-fail>
    </abilitycheck>
    <spline></spline>
    <abilitydescription>
      <p noindent="true">
	Demons project their wills into this plane and create
	physical proxies of themselves from ectoplasm which they
	control as puppet masters from beyond.  Maintaining these
	forms requires an act of will.  As the demons corporeal forms
	suffer damage it becomes increasingly difficult for them
	to maintain the integrity of their projected forms.
      </p>

      <p>
	In game, the way this works is that whenever a demon is hit
	for 10 or more damage they make a Mettle Check and if they fail
	they become unstable the demon's connection to the simulacrum
	is broken and the simulacrum dissipates into foul smelling ooze.
	A demon's simulacrum has no hit points per se, only a mettle pool.
      </p>
    </abilitydescription>
  </ability>  

  
  <ability>
    <abilitytitle>Fleet</abilitytitle>
    <abilityid>fleet</abilityid>
    <param-rank>3</param-rank>
    <spline></spline>
    <abilitydescription>
      <p noindent="true">
        The NPC takes an additional move action each round for each rank of
	fleet they have.
      </p>
    </abilitydescription>
  </ability>

    
  <ability>
    <abilitytitle>Fly</abilitytitle>
    <abilityid>fly</abilityid>
    <spline></spline>
    <abilitydescription>
      <p noindent="true">
	The monster can fly.   They can move over terrain that they
	would not be able to under normal conditions such as pits and
	rivers.  The monster only needs to make a check for flying in difficult
	situations, when they are attempting to carry something heavy or in the
	strong winds.
      </p>
    </abilitydescription>
  </ability>  

  
  <ability>
    <abilitytitle>Horns</abilitytitle>
    <abilityid>horns</abilityid>
    <param-dmg>4</param-dmg>    
    <param-rank>3</param-rank>
    <abilitycheck>
      <name>Opposed</name>
      <checktype><melee-attack/></checktype>
      <apcost><ap3/></apcost>
      <range><reach/></range>      
      <keywords><melee/><check/></keywords>
      <precondition>Only available when charging</precondition>
      <counter><opponents-physical-defence/></counter>
