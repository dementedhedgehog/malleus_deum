  <ability>
    <abilitytitle>Prehensile Tail</abilitytitle>
    <abilityid>prehensile_tail</abilityid>
    <param-rank>3</param-rank>
    <abilitycheck>
      <name>Opposed</name>
      <checktype><melee-attack/></checktype>
      <apcost><ap2/></apcost>
      <range><reach/></range>
      <keywords><melee/><check/><noarmour/><unblockable/></keywords>
      <counter><opponents-physical-defence/></counter>
      <success>No Damage</success>
      <any-fail>Grabbed</any-fail>
      <grimfail>Crushed 2 Damage</grimfail>
    </abilitycheck>
    <spline></spline>
    <abilitydescription>
      <p noindent="true">
	The monster has a prehensile tail that they can use to climb, grab
	things.  At higher ranks the monster can wield a weapon using
	the tail. 
      </p>
    </abilitydescription>
  </ability>
  

  <ability>
    <abilitytitle>Prehensile Tongue</abilitytitle>
    <abilityid>prehensile_tongue</abilityid>
    <param-rank>3</param-rank>
    <abilitycheck>
      <name>Opposed</name>
      <checktype><melee-attack/></checktype>
      <apcost><ap2/></apcost>
      <range><reach/></range>
      <keywords><melee/><check/><noarmour/><unblockable/></keywords>
      <counter><opponents-physical-defence/></counter>
    </abilitycheck>
    <spline></spline>
    <abilitydescription>
      <p noindent="true">
	The monster has a tongue that they can shoot out a distance of <m6/> and
	grab things with.  If successful the target is grabbed with a Strength
	8+3xRank DC.
      </p>
    </abilitydescription>
  </ability>

  
  <ability>
    <abilitytitle>Regeneration</abilitytitle>
    <abilityid>regeneration</abilityid>
    <param-dmg>4</param-dmg>    
    <param-rank>3</param-rank>
    <abilityauxiliary>
      <name>Talent</name>
      <checktype><auxiliary/></checktype>
      <apcost><free/></apcost>
      <range><self/></range>
      <keywords><auxiliary/></keywords>
      <precondition>Start of the round</precondition>
      <effect>Character regains rank hit points</effect>
    </abilityauxiliary>
    <spline></spline>
    <abilitydescription>
      <p noindent="true">
    	At the start of the creatures turn it regenerates Rank hit points.
      </p>
    </abilitydescription>
  </ability>

  
  <ability>
    <abilitytitle>Summon Demon</abilitytitle>
