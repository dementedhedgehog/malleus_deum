  <ability>
    <abilitytitle>Spiritual Torment</abilitytitle>
    <abilityid>spiritual-torment</abilityid>
    <param-rank>3</param-rank>
    <abilityranks from="1" to="5"/>
    <abilitycheck>
      <name>When Surprised</name>
      <checktype><aspect/></checktype>
      <apcost><free-interrupt/></apcost>
      <range><na/></range>
      <keywords><check/><aspect/></keywords>
      <counter><opponents-speed-or-perception-save/></counter> 
      <any-success>Your breath is held.</any-success>
      <any-fail>Your breath is not held.</any-fail>
    </abilitycheck>
    <abilitydescription>
      <p>
	Flashbacks, nightmares, and severe anxiety were often blamed on demons,
	ghosts, or the devil haunting the afflicted person.
      </p>
    </abilitydescription>
  </ability>
  
