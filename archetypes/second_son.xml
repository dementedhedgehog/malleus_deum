	    <choice><abilityref id="survivalism" rank="1"/>, ,  or <abilityref id="dodge" rank="2"/>, <abilityref id="climb" rank="1"/> or ✱swim, <abilityref id="singing" rank="2"/></choice>
	  </path>

	  <path chance="9-11">
	    <pathtitle></pathtitle>
	    <choice><abilityref id="riding" rank="2"/>, <abilityref id="animal_handling" rank="1"/>, <abilityref id="juggernaut" rank="2"/>,  or , <abilityref id="brawl" rank="2"/></choice>
	  </path>

	  <path chance="12">
	    <pathtitle>Choose one of the above</pathtitle>
	  </path>
