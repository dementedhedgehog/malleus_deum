      <branch>
	<branchtitle>Second Sons Training</branchtitle>
	<branchdescription>
	  <p>All Second Sons start with the following skills:</p>
	</branchdescription>
	<path chance="">
	  <pathtitle></pathtitle>
	  <all-of><abilityref id="sword_strike" rank="2"/>, <abilityref id="parry" rank="1"/>, <abilityref id="dodge" rank="1"/>, 
      <abilityref id="etiquette" specializations="Westreich-Nobility"/>, <abilityref id="merovingian" rank="4"/>, <abilityref id="lucky" rank="3"/>, <abilityref id="itiok" rank="1"/>, <abilityref id="nick_of_time" rank="1"/>,
      <abilityref id="book_learning" rank="1"/>, and <abilityref id="riding" rank="1"/>.</all-of>
	</path>
      </branch>
      
      
