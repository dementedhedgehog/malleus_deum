	    </p>
	  </branchdescription>
	    
	  <path chance="1-2">
	    <pathtitle>Laibstadt</pathtitle>
	    <choice><abilityref id="merovingian" rank="4"/>, <abilityref id="aquilonian" rank="2"/>,
	    <abilityref id="history" specializations="Westreich"/>, ✱2[Westreich],
	    <abilityref id="etiquette" specializations="Westreich-Nobility"/></choice>
	  </path>
	  <path chance="3-9">
	    <pathtitle>Westreich</pathtitle>
	    <choice><abilityref id="merovingian" rank="4"/>, <abilityref id="aquilonian" rank="2"/>,
	    <abilityref id="history" specializations="Westreich"/>, <abilityref id="fame" specializations="Westreich"/>,
	    <abilityref id="etiquette" specializations="Westreich-Nobility"/>, <abilityref id="farmer" rank="1"/></choice>
	  </path>
	  <path chance="10">
	    <pathtitle>Alemaigne</pathtitle>
	    <choice><abilityref id="merovingian" rank="3"/>, <abilityref id="aquilonian" rank="1"/>, <abilityref id="alemagne" rank="4"/>, 
	    <abilityref id="history" specializations="Westreich"/>, <abilityref id="history" specializations="Alemaigne"/>,
	    ✱2[Westreich],
	    <abilityref id="etiquette" specializations="Westreich-Nobility"/>,
	    <abilityref id="etiquette" specializations="Allemagne-Nobility"/></choice>
	  </path>
	  <path chance="11">
	    <pathtitle>Albion</pathtitle>
	    <choice><abilityref id="merovingian" rank="3"/>, <abilityref id="aquilonian" rank="1"/>, <abilityref id="hybernian" rank="2"/>, 
	    <abilityref id="history" specializations="Westreich"/>,
	    <abilityref id="history" specializations="Albion"/>,
	    <abilityref id="fame" specializations="Albion"/>,
	    <abilityref id="fame" specializations="Westreich"/>,
	    <abilityref id="etiquette" specializations="Westreich-Nobility"/>,
	    <abilityref id="etiquette" specializations="Albion-Nobility"/></choice>
	    <choice><abilityref id="occitan" rank="1"/>, or <abilityref id="leonese" rank="1"/>, or <abilityref id="poitevin" rank="1"/></choice>
	  </path>
	  <path chance="12">
	    <pathtitle>Choose one of the above</pathtitle>
	  </path>
      </branch>


