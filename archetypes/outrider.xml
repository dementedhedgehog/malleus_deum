      	  <choice>Rope <m20/>, Straw Hat, Paper and ink</choice>
      	</path>
      	<path chance="6-7">
      	  <pathtitle></pathtitle>
      	  <choice>Cavalier Hat, Kettle, Book of Poetry</choice>
      	</path>
      	<path chance="8-9">
      	  <pathtitle></pathtitle>
      	  <choice>Garibaldi Hat, Small Hammer and Chisel, Scarf</choice>
      	</path>
      	<path chance="10-11">
      	  <pathtitle></pathtitle>
      	  <choice>Chaperon, Playing Cards, Small Pot</choice>
      	</path>
      	<path chance="12">
      	  <pathtitle></pathtitle>
      	  <choice>Choose one of the above.</choice>
      	</path>
      </branch>


