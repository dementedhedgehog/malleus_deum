    <img id="altdorfer_champion_of_mithras"/>
    </figure>
    

    <figure>
    <!-- <img id="durer_champion_of_mithras" scale="0.25"/> -->
    <img id="durer_champion_of_mithras"/>
    </figure>
    
  </archetypedescription>
  <archetypeprimaryabilities>
    <list> 
      <li>Str:+2, End:+1, Ag:-1, Spd:+0, Per:+0 or</li>
      <li>Str:+1, End:+1, Ag:+0, Spd:+0, Per:+0</li>
    </list>
  </archetypeprimaryabilities>
