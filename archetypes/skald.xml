<?xml version="1.0" encoding="utf-8"?>
<!-- northerner bard/barbarian/light fighter/thief -->
<archetype>
  <archetypetitle>Skald</archetypetitle>
  <archetypeid>skald</archetypeid>
  <archetypedescription>     
    
    <p>
      Skalds are itinerant entertainers, they travel the countryside playing music, reciting poetry
      and making fun of the church and the nobility for their keep.  They seek out heros and adventure,
      the subjects of the great epics they wish to write.  Often they desire fame and fortune through
      their craft.  Skalds are typically not backward in coming forward.  They are a light in the
      darkness, assuaging the fears of the people and bastioning them against the creatures of the night.
    </p>
    

  </archetypedescription>
  <archetypeprimaryabilities>    
    <list> 
      <li>Str:-1, End:+0, Ag:+1, Spd:+1, Per:+1 or</li>
      <li>Str:+0, End:+0, Ag:+0, Spd:+1, Per:+1</li>
    </list>
  </archetypeprimaryabilities>

  <archetypemovedistance>6</archetypemovedistance>
  <startingcash>20 + d4 sp</startingcash>
  <startinggear>Gambeson, one of flail, mace or morning star, dagger, rations for a week.</startinggear>

  <height>
    <metric>162 + 3d10 cm</metric>
    <imperial>5'5" + 2d6 inches</imperial>
  </height>
  <weight>
    <metric>65 + 3d10 kg</metric>
    <imperial>143 + 3d20 pounds</imperial>
  </weight>
  <age>26 + 2d6 years</age>
  <gender>Your gender is male.</gender>

  <aspectexamples>You must choose: Brother of Mithras, other suggestions are: I have been Chosen,
  Unshakeable Belief, Faith for my Heart the Bottle for my Head, Do not speak her name, Do Not Tempt Me.
  It is a Long Story, Sudden in Choler.
  </aspectexamples>
  <archetypekeywords>
    <human/>
    <humanoid/>    
    <medium/>
  </archetypekeywords>



  <archetypelevels>
    <archetypelevel>
      <levelnumber>1</levelnumber>
      <levelstamina>1d4+7</levelstamina>
      <levelhealth>1d4+6</levelhealth>
      <levelhealthrefresh>2d4</levelhealthrefresh>
      <levelluck>3</levelluck>
      <levelluckrefresh>1</levelluckrefresh>
      <levelmagic>2</levelmagic>
      <levelmagicrefresh>1</levelmagicrefresh>
      <levelmettle>3</levelmettle>
      <levelmettlerefresh>1</levelmettlerefresh>

      <branch>
	<branchtitle>Skald Training</branchtitle>
	<branchdescription>
	  <p>All Skalds start with the following skills</p>
	</branchdescription>
	<path chance="">
	  <pathtitle></pathtitle>
	  <choice><abilityref id="merovingian" rank="4"/></choice>
	  <choice>      
	    Choose one of <abilityref id="strings" rank="2"/>, <abilityref id="keyed" rank="2"/>, or
	    <abilityref id="wind" rank="2"/>.  Choose one of <abilityref id="dance" rank="1"/> or <abilityref id="oratory" rank="1"/>.
	    Choose one of <abilityref id="aquilonian" rank="1"/> or <abilityref id="dwarven" rank="1"/>.  Choose one of <abilityref id="history" rank="1"/> or
	    <abilityref id="occult" rank="1"/>.
	  </choice>    	  
	</path>
      </branch>      
    </archetypelevel>
  </archetypelevels>

  
