{% macro insert_action_symbol(check) %}
{%- if check.ap_cost == 'Free' -%}
<freeactionsymbol/>
{%- elif check.ap_cost == '1AP' -%}
<oneactionsymbol/>
{%- elif check.ap_cost == '2AP' -%}
<twoactionsymbol/>
{%- elif check.ap_cost == '3AP' -%}
<threeactionsymbol/>
{%- elif check.ap_cost == '4AP' -%}
<fouractionsymbol/>
{%- elif check.ap_cost == '5AP' -%}
<fiveactionsymbol/>
{%- elif check.ap_cost == 'Save' -%}
<savesymbol/>
{%- elif check.ap_cost == 'Free Save' -%}
<freesavesymbol/>
{%- elif check.ap_cost == 'Reaction' -%}
<reactionsymbol/>
{%- elif check.ap_cost == 'Free Reaction' -%}
<freereactionsymbol/>
{%- elif check.ap_cost == 'Mandatory Reaction' -%}
<mandatoryreactionsymbol/>
{%- elif check.ap_cost == 'Mandatory Free Reaction' -%}
<mandatoryfreereactionsymbol/>
{%- elif check.ap_cost == 'Free Reaction/Interrupt' -%}
<freereactionorinterruptsymbol/>
{%- elif check.ap_cost == 'Reaction/Interrupt' -%}
<reactionorinterruptsymbol/>
{%- elif check.ap_cost == 'Reaction/2AP' -%}
<reactionsymbol/>/<twoactionsymbol/>
{%- elif check.ap_cost == 'Interrupt/2AP' -%}
<interruptsymbol/>/<twoactionsymbol/>
{%- elif check.ap_cost == 'GM-Fiat' -%}
<gmfiatsymbol/>
{%- elif check.ap_cost == 'Interrupt' -%}
<interruptsymbol/>
{%- elif check.ap_cost == 'Free Interrupt' -%}
<freeinterruptsymbol/>
{%- elif check.ap_cost == 'Mandatory Interrupt' -%}
<mandatoryinterruptsymbol/>
{%- elif check.ap_cost == 'Mandatory Free Interrupt' -%}
<mandatoryfreeinterruptsymbol/>
{%- elif check.ap_cost == 'Noncombat' -%}
<outofcombatsymbol/>
{%- endif -%}
{%- endmacro -%}


{#-

 Formats an Ability

-#}
{% macro build_ability(ability) %}
<spacer/>
<subsubsection>
  <subsubsectiontitle isabilitytitle="true">
    {%- if ability.is_antag_ability() -%}<antagonistsymbol/> {%- endif -%}
    {{- ability.get_name() -}}{{ " " }}
    {%- if ability.has_ranks() -%}
    {%- if ability.untrained_rank  -%}
    <bold>({{ ability.untrained_rank }}) </bold>
    {%- endif -%}
    {%- set from_rank, to_rank = ability.get_ability_trained_rank_range() -%}
    {{ from_rank }}<endash/>{{ to_rank }}    
    {%- endif -%}    
    {%- if ability.has_parameters() -%}
    <hfill/><smaller>Params: [{{ability.get_parameters_str()}}]</smaller>
    {%- endif -%}
    {#- eat extra newlines as latex doesn't like them in movable arguments -#}
  </subsubsectiontitle>
  <indexentry>
    <entry>{{- ability.get_name() }} Ability</entry>
  </indexentry>
  <indexentry>
    <entry>Ability</entry>
    <subentry>{{- ability.get_name() }}</subentry>
  </indexentry>
  {%- if ability.slug -%}
  <vspace>-0.3</vspace>
  <epigraph>{{ ability.slug }}</epigraph>
  {%- endif -%}
  <vspace>-0.5</vspace>
  
  <p>
    <smaller>
      {%- if ability.prerequisites -%}
      <bold>Prereqs:</bold> {{ ability.get_prerequisites_str() }}
      {%- endif -%}
      {%- if ability.specializations -%}
      <bold>Specializations:</bold> {{ ability.get_specializations_str() }}
      {%- endif %}      
      {%- if ability.get_checks() -%}
      {%- for check in ability.get_checks() -%}
      <indent>
	<vspace>0.8</vspace>
	{%- if check.check_class == 'Check' -%}
	<checksymbol/><bold> {{check.name}}</bold>
	{{- insert_action_symbol(check) }} vs {{ check.counter }}
	{%- elif check.check_class == 'Countercheck' -%}
	<savesymbol/> <bold>{{check.name}}</bold>
	{{- insert_action_symbol(check) -}}	
	{%- elif check.check_class == 'Auxiliary' -%}
	<auxiliarysymbol/> <bold>{{check.name}}</bold>
	{{- insert_action_symbol(check) }}
	{%- else -%}
	<bold>FIXME:</bold> UNKNOWN CHECK TYPE: {{ check.check_type }}
	{%- endif -%}
	<br/>
	<bold>Crits:</bold> {{ check.get_check_type() + " " }}
	{%- if check.pool_cost -%}
	<bold>Pool Cost:</bold> {{ check.get_pool_cost_str() }}
	{%- endif -%}
	<bold>Range:</bold> {{ check.check_range + " " -}}
	{%- if check.dmg -%}
	<bold>Damage:</bold> {{ check.dmg  + " " }}
	{%- endif -%}
	{%- if check.keywords -%}
	<bold>Keywords:</bold> {{ check.get_keywords_str()  + " " }}
	{%- endif -%}
	{%- if check.requires %}
	<bold>Requires:</bold> {{ check.requires }}	
	{%- endif -%}
	{%- if check.precondition %}	
	<br/><bold>Preconditions:</bold> {{ check.precondition }}
	{%- endif -%}
	{% if check.effect -%}
	<br/><bold>Effect:</bold> {{ check.effect }}
	{%- endif -%}
	{%- if check.has_outcomes() %}
	<br/><bold>Outcomes:</bold><indent>
	{%- for outcome in check.get_outcomes() -%}
	{%- set name, result = outcome -%}	
	<br/><bold>{{ name }}:</bold> {{ result }}
	{%- endfor -%}
      </indent>
      {%- endif -%}
      </indent>
      {%- endfor -%}
      {%- endif -%}
    </smaller>
    <vspace>1</vspace>
  </p>
  {%- if ability.stages -%}
  <p>
    <smaller>
      <bold>Stages:</bold>
      <indent>
	{% for stage in ability.stages -%}    
	<vspace>0.6</vspace><br/>
	<bold>{{ loop.index }}: {{ stage.name }}</bold> {{ stage.description }}
	{%- endfor %}
      </indent>
    </smaller> 
    <vspace>1</vspace>
  </p>      
  {%- endif %}            
  {%- if ability.description -%}
  {{ ability.description }}
  {%- endif -%}
  <divider/>
</subsubsection>  
<spacer/>
{%- endmacro -%}
