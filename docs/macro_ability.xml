{% macro insert_cost_symbol(cost) %}
{%- if cost == 'Free' -%}
<freeactionsymbol/>
{%- elif cost == '1AP' -%}
<oneactionsymbol/>
{%- elif cost == '2AP' -%}
<twoactionsymbol/>
{%- elif cost == '3AP' -%}
<threeactionsymbol/>
{%- elif cost == '4AP' -%}
<fouractionsymbol/>
{%- elif cost == db.ABILITY_COST_AP5_NAME -%}
<fiveactionsymbol/>
{%- elif cost == db.ABILITY_COST_MULTI_ROUND_NAME -%}
<multiroundactionsymbol/>
{%- elif cost == db.ABILITY_COST_SAVE_NAME -%}
<savesymbol/>
{%- elif cost == 'Free Save' -%}
<freesavesymbol/>
{%- elif cost == 'Save/Free Save' -%}
<saveorfreesavesymbol/>
{%- elif cost == 'Response' -%}
<responsesymbol/>
{%- elif cost == 'Free Response' -%}
<freeresponsesymbol/>
{%- elif cost == 'Mandatory Response' -%}
<mandatoryresponsesymbol/>
{%- elif cost == 'Mandatory Free Response' -%}
<mandatoryfreeresponsesymbol/>
{%- elif cost == 'Free Response/Interrupt' -%}
<freeresponseorinterruptsymbol/>
{%- elif cost == 'Response/Interrupt' -%}
<responseorinterruptsymbol/>
{%- elif cost == 'GM Fiat' -%}
<gmfiatchecksymbol/>
{%- elif cost == 'Interrupt' -%}
<interruptsymbol/>
{%- elif cost == 'Free Interrupt' -%}
<freeinterruptsymbol/>
{%- elif cost == 'Mandatory Interrupt' -%}
<mandatoryinterruptsymbol/>
{%- elif cost == 'Mandatory Free Interrupt' -%}
<mandatoryfreeinterruptsymbol/>
{%- elif cost == 'Noncombat' -%}
<outofcombatsymbol/>
{%- elif cost == 'Start of Turn' -%}
<startofturnsymbol/>
{%- elif cost == 'Any OOTA' -%}
<anyootasymbol/>
{%- else -%}
UNKNOWN COST!! "{{ cost }}"
{%- endif -%}
{%- endmacro -%}



{%- macro insert_action_cost_symbol(check) -%}
{%- set cost = check.cost -%}
{{- insert_cost_symbol(cost) -}}
{%- endmacro -%}


{%- macro insert_reaction_cost_symbol(check) -%}
{%- set cost = check.reaction_cost -%}
{%- if cost is not none -%}
{{- insert_cost_symbol(cost) -}}
{%- endif -%}
{%- endmacro -%}


{%- macro insert_verb_symbol(verb) -%}
{%- if verb == db.CHECK_VERB_ACTION_NAME -%}
<actionsymbol/>
{%- elif verb == db.CHECK_VERB_REACTION_NAME -%}
<reactionsymbol/>
{%- elif verb == db.CHECK_VERB_AUXILIARY_NAME -%}
<auxiliarysymbol/>
{%- else -%}
FIXME UNKNOWN CHECK VERB '{{ verb }}'!!
{%- endif -%}
{%- endmacro -%}



{% macro format_check(check) %}
    {%- set verb = check.get_check_verb() -%}
    <vspace length="1.0"/><br/>
    {{- insert_verb_symbol(verb) + " " -}}
    <bold>{{check.name}}</bold><br/>
    
    {#- ***CHECK*** -#}
    {%- if verb == db.CHECK_VERB_ACTION_NAME -%}
        <bold>{{- check.action }}</bold>
	{{-" " + insert_action_cost_symbol(check) + " "-}}
        <checkarrowsymbol/><vssavearrowsymbol/>{{- " " -}}
        <antagonistsymbol/>
	<smaller>{{- check.reaction }}</smaller><br/>
	
    {#- ***SAVE*** -#}
    {%- elif verb == db.CHECK_VERB_REACTION_NAME -%}	
        <antagonistsymbol/>
	{{-" " + insert_action_cost_symbol(check) + " "-}}
        {{- check.action -}}
        <vscheckarrowsymbol/><savearrowsymbol/>
	{{-" " + insert_reaction_cost_symbol(check) + " "-}}
	<bold>{{check.reaction}}</bold><br/>
	
    {#- ***Auxiliary*** -#}
    {%- elif verb == db.CHECK_VERB_AUXILIARY_NAME -%}
	{# {- " " + insert_auxiliary_cost_symbol(check) + " "-} #}

    {#- ***Error!*** #}{%- else -%}
	<bold>FIXME:</bold> UNKNOWN CHECK VERB: {{ verb }}
    {%- endif -%}	

    {%- if check.pool_cost -%}
    <bold>Pool Cost:</bold> {{ check.get_pool_cost_str()  + " " }}
    {%- endif -%}
    <bold>Range:</bold> {{ check.check_range + " " -}}
    {%- if check.dmg -%}
    <bold>Damage:</bold> {{ check.dmg  + " " }}
    {%- endif -%}
    {%- if check.keywords -%}
    <bold>Keywords:</bold> {{ check.get_check_keywords_str()  + " " }}
    {%- endif -%}
    {%- if check.requires %}
    <bold>Requires:</bold> {{ check.requires }}	
    {%- endif -%}
    {%- if check.precondition %}	
    <br/><bold>Preconditions:</bold> {{ check.precondition }}
    {%- endif -%}
    {% if check.effect -%}
    <br/><bold>Effect:</bold> {{ check.effect }}
    {%- endif -%}

    {%-
        if check.get_crit_class() not in [
            db.CHECK_CRITS_LISTED_BELOW_NAME,
            db.CHECK_CRITS_NO_CRITS_NAME,
	    None,
	]
    %}
    <bold>Crits:</bold> {{ check.get_crit_class()|string + " " }}
    {%- endif -%}
    {%- if check.has_outcomes() %}
    <br/><bold>Outcomes:</bold><indent>
    {%- for outcome in check.get_outcomes() -%}
    {%- set name, result = outcome -%}	
    <br/><bold>{{ name }}:</bold> {{ result }}
    {%- endfor -%}
    </indent>
    {%- endif -%}	
{%- endmacro -%}

{% macro format_ability(ability) %}
<spacer/>
<subsubsection>
  <abilitytitle label="{{ ability.get_label() }}">
    {{- ability.get_name() + " " -}}    
    {%- if ability.has_untrained_rank() -%}
    <bold>({{ ability.get_untrained_rank() }}) </bold>
    {%- endif -%}
    {%- if ability.has_trained_ranks() -%}
      {%- set from_rank, to_rank = ability.get_ability_trained_rank_range() -%}
      {%- if from_rank == to_rank -%}
        {{ from_rank }}
      {%- else -%}	
        {{ from_rank }}<endash/>{{ to_rank }}    
      {%- endif -%}    
    {%- endif -%}    
    {%- if ability.has_parameters() -%}
    <hfill/><smaller>Params: [{{ability.get_parameters_str()}}]</smaller>
    {%- endif -%}
    {#- eat extra newlines as latex doesn't like them in movable arguments -#}
  </abilitytitle>
  {%- if ability.slug -%}
  <slug>{{ ability.slug }}</slug>
  {%- endif -%}
  <indexentry>
    <entry>{{- ability.get_name() }} Ability</entry>
  </indexentry>
  <indexentry>
    <entry>Ability</entry><subentry>{{- ability.get_name() }}</subentry>
  </indexentry>
  <vspace length="-0.5"/>
  <p>
    <smaller>
      <bold>Keywords:</bold> {{ ability.get_keywords_str()  + " " }}
      {%- if ability.prerequisites -%}
      <bold>Prereqs:</bold> {{ ability.get_prerequisites_str()  + " " }}
      {%- endif -%}
      {%- if ability.specializations -%}
      <bold>Specializations:</bold> {{ability.get_specializations_str()  + " "}}
      {%- endif %}      
      {%- if ability.get_checks() -%}
      {%- for check in ability.get_checks() -%}
      <indent>
	{{- format_check(check) -}}
      </indent>
      {%- endfor -%}
      {%- endif -%}
    </smaller>
    <vspace length="0.5"/>
  </p>
  {%- if ability.qualifiers -%}
  <p>
    <smaller>
      <bold>Qualifiers:</bold>
      <indent>
	{% for qualifier in ability.qualifiers -%}    
	<vspace length="0.4"/><br/>
	<bold>{{ qualifier.name }}</bold> {{ qualifier.description }}
	{%- endfor %}
      </indent>
    </smaller> 
    <vspace length="1"/>
  </p>      
  {%- endif %}  
  {%- if ability.additional_qualifiers -%}
  <p>
    ---
    <smaller>
      <indent>
	{% for qualifier in ability.additional_qualifiers -%}    
	<vspace length="0.4"/><br/>
	<bold>{{ qualifier.name }}</bold> {{ qualifier.description }}
	{%- endfor %}
      </indent>
    </smaller> 
    <vspace length="1"/>
  </p>      
  {%- endif %}  
  {%- if ability.stages -%}
  <p>
    <smaller>
      <bold>Stages:</bold>
      <indent>
	{% for stage in ability.stages -%}    
	<vspace length="0.4"/><br/>
	<bold>{{ loop.index }}: {{ stage.name }}</bold> {{ stage.description }}
	{%- endfor %}
      </indent>
    </smaller> 
    <vspace length="1"/>
  </p>      
  {%- endif %}  
  {%- if ability.description -%}
  {{- ability.description -}}
  {%- endif -%}
  <divider/>
</subsubsection>
<spacer/>     
{%- endmacro -%}
