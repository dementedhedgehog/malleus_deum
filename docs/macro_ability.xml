{% macro insert_symbol(ap_cost) %}
{%- if ap_cost == 'Free' -%}
<freeactionsymbol/>
{%- elif ap_cost == '1AP' -%}
<oneactionsymbol/>
{%- elif ap_cost == '2AP' -%}
<twoactionsymbol/>
{%- elif ap_cost == '3AP' -%}
<threeactionsymbol/>
{%- elif ap_cost == '4AP' -%}
<fouractionsymbol/>
{%- elif ap_cost == '5AP' -%}
<fiveactionsymbol/>
{%- elif ap_cost == 'Save' -%}
<savesymbol/>
{%- elif ap_cost == 'Free Save' -%}
<freesavesymbol/>
{%- elif ap_cost == 'Save/Free Save' -%}
<saveorfreesavesymbol/>
{%- elif ap_cost == 'Reaction' -%}
<reactionsymbol/>
{%- elif ap_cost == 'Free Reaction' -%}
<freereactionsymbol/>
{%- elif ap_cost == 'Mandatory Reaction' -%}
<mandatoryreactionsymbol/>
{%- elif ap_cost == 'Mandatory Free Reaction' -%}
<mandatoryfreereactionsymbol/>
{%- elif ap_cost == 'Free Reaction/Interrupt' -%}
<freereactionorinterruptsymbol/>
{%- elif ap_cost == 'Reaction/Interrupt' -%}
<reactionorinterruptsymbol/>
{%- elif ap_cost == 'Reaction/2AP' -%}
<reactionsymbol/>/<twoactionsymbol/>
{%- elif ap_cost == 'Interrupt/2AP' -%}
<interruptsymbol/>/<twoactionsymbol/>
{%- elif ap_cost == 'GM-Fiat' -%}
<gmfiatchecksymbol/>
{%- elif ap_cost == 'Interrupt' -%}
<interruptsymbol/>
{%- elif ap_cost == 'Free Interrupt' -%}
<freeinterruptsymbol/>
{%- elif ap_cost == 'Mandatory Interrupt' -%}
<mandatoryinterruptsymbol/>
{%- elif ap_cost == 'Mandatory Free Interrupt' -%}
<mandatoryfreeinterruptsymbol/>
{%- elif ap_cost == 'Noncombat' -%}
<outofcombatsymbol/>
{%- endif -%}
{%- endmacro -%}

{% macro insert_check_symbol(check) %}
{{- insert_symbol(check.ap_cost) -}}
{%- endmacro -%}


{%- macro insert_save_symbol(check) -%}
{{- insert_symbol(check.counter) -}}
{%- endmacro -%}




{#-

 Formats an Ability

-#}
{% macro build_ability(ability) %}
<spacer/>
<subsubsection>
  <subsubsectiontitle isabilitytitle="true">
    {%- if ability.is_antag_ability() -%}<antagonistsymbol/> {%- endif -%}
    {{- ability.get_name() -}}{{ " " }}
    {%- if ability.has_ranks() -%}
    {%- if ability.untrained_rank  -%}
    <bold>({{ ability.untrained_rank }}) </bold>
    {%- endif -%}
    {%- set from_rank, to_rank = ability.get_ability_trained_rank_range() -%}
    {{ from_rank }}<endash/>{{ to_rank }}    
    {%- endif -%}    
    {%- if ability.has_parameters() -%}
    <hfill/><smaller>Params: [{{ability.get_parameters_str()}}]</smaller>
    {%- endif -%}
    {#- eat extra newlines as latex doesn't like them in movable arguments -#}
  </subsubsectiontitle>
  <indexentry>
    <entry>{{- ability.get_name() }} Ability</entry>
  </indexentry>
  <indexentry>
    <entry>Ability</entry>
    <subentry>{{- ability.get_name() }}</subentry>
  </indexentry>
  {%- if ability.slug -%}
  <vspace length="-0.3"/>
  <epigraph>{{ ability.slug }}</epigraph>
  {%- endif -%}
  <vspace length="-0.5"/>
  
  <p>
    <smaller>
      <bold>Keywords:</bold> {{ ability.get_keywords_str()  + " " }}
      {%- if ability.prerequisites -%}
      <bold>Prereqs:</bold> {{ ability.get_prerequisites_str()  + " " }}
      {%- endif -%}
      {%- if ability.specializations -%}
      <bold>Specializations:</bold> {{ability.get_specializations_str()  + " "}}
      {%- endif %}      
      {%- if ability.get_checks() -%}
      {%- for check in ability.get_checks() -%}
      <indent>
	<vspace length="1.0"/><br/>
	<abilitybulletsymbol/>
	{#- ***CHECK*** #}{%- if check.check_class == 'Check' -%}
	<bold>{{check.name}}</bold>{{ insert_check_symbol(check) }}
	<hspace length="2"/><checkarrowsymbol/><hspace length="5"/>
	<vssavearrowsymbol/><hspace length="2"/>
	{{- insert_save_symbol(check) }}{{check.counter}}
	{#- ***SAVE*** #}{%- elif check.check_class == 'Countercheck' -%}
	{{check.name}}{{ insert_check_symbol(check) -}}
	<vscheckarrowsymbol/><hspace length="5"/>
	<savearrowsymbol/>{{ insert_save_symbol(check) }}<bold>{{check.name}}</bold>
	{#- ***Auxiliary*** #}{%- elif check.check_class == 'Auxiliary' -%}	
	<bold>{{check.name}}</bold> <vscheckarrowsymbol/>
	<hspace/>	
	<versus/>
	<hspace/>
	{{ check.counter }}
	{#- ***Error!*** #}{%- else -%}
	<bold>FIXME:</bold> UNKNOWN CHECK TYPE: {{ check.check_type }}
	{%- endif %}	
	<br/><bold>Crits:</bold> {{ check.get_check_type() + " " }}
	{%- if check.pool_cost -%}
	<bold>Pool Cost:</bold> {{ check.get_pool_cost_str() }}
	{%- endif -%}
	<bold>Range:</bold> {{ check.check_range + " " -}}
	{%- if check.dmg -%}
	<bold>Damage:</bold> {{ check.dmg  + " " }}
	{%- endif -%}
	{%- if check.keywords -%}
	<bold>Keywords:</bold> {{ check.get_check_keywords_str()  + " " }}
	{%- endif -%}
	{%- if check.requires %}
	<bold>Requires:</bold> {{ check.requires }}	
	{%- endif -%}
	{%- if check.precondition %}	
	<br/><bold>Preconditions:</bold> {{ check.precondition }}
	{%- endif -%}
	{% if check.effect -%}
	<br/><bold>Effect:</bold> {{ check.effect }}
	{%- endif -%}
	{%- if check.has_outcomes() %}
	<br/><bold>Outcomes:</bold><indent>
	{%- for outcome in check.get_outcomes() -%}
	{%- set name, result = outcome -%}	
	<br/><bold>{{ name }}:</bold> {{ result }}
	{%- endfor -%}
      </indent>
      {%- endif -%}
      </indent>
      {%- endfor -%}
      {%- endif -%}
    </smaller>
    <vspace length="0.8"/>
  </p>
  {%- if ability.stages -%}
  <p>
    <smaller>
      <bold>Stages:</bold>
      <indent>
	{% for stage in ability.stages -%}    
	<vspace length="0.6"/><br/>
	<bold>{{ loop.index }}: {{ stage.name }}</bold> {{ stage.description }}
	{%- endfor %}
      </indent>
    </smaller> 
    <vspace length="1"/>
  </p>      
  {%- endif %}            
  {%- if ability.description -%}
  {{ ability.description }}
  {%- endif -%}
  <divider/>
</subsubsection>  
<spacer/>
{%- endmacro -%}
