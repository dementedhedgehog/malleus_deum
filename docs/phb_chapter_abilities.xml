
  {% from "docs/macro_ability.xml" import build_ability with context %}

<chapter>
  <chaptertitle>Abilities<label>ch:abilities</label></chaptertitle>

  <indexentry><entry>Abilities</entry></indexentry>
  <p>
    <dropcap>This</dropcap> chapter details the abilities available to
    characters in the game. Every character possesses a unique set of
    abilities. Abilities allow characters to provide passive benefits or to
    perform actions by making ability checks.
  </p>
  
  <section>
    <sectiontitle>Primary Abilities</sectiontitle>
    <indexentry><entry>Abilities</entry><subentry>Primary</subentry></indexentry>
  
  {% for ag in ability_groups
     if ag.get_family_id() == db.ABILITY_FAMILY_PRIMARY_ID %}
    {{ ag.get_description() }}
    
    {% if ag.has_abilities() and ag.draw_skill_tree() %}
    <figure position="h" fullwidth="false" sideways="false">
      <img buildfname="{{ ag.get_id() }}_skill_tree.pdf"/>
      <caption>{{ ag.get_name() }}</caption>
      <label>figure:{{ ag.get_id() }}_skill_tree</label>
    </figure>
    {% endif %}

    {% for ability in ag.get_abilities()%}
    {{ build_ability(ability) }}
    {% endfor %}
  {% endfor %}
  </section>


  
  <section>
    <sectiontitle>Scholarly Abilities</sectiontitle>
    <p>
      <indexentry><entry>Abilities</entry><subentry>Scholarly</subentry></indexentry>
      These abilities are typically associated with formal study, including
      fields such as Antiquities, Natural History, Alchemy, <etc/>.
    </p>


    {% for ag in ability_groups
       if ag.get_family_id() == db.ABILITY_FAMILY_LORE_ID %}
    
    <subsection>
      <subsectiontitle>{{ ag.get_name() }}</subsectiontitle>
      {{ ag.get_description() }}

      {% if ag.has_abilities() %}
      <figure position="h" fullwidth="false" sideways="false">
	<img buildfname="{{ ag.get_id() }}_skill_tree.pdf"/>
	<caption>{{ ag.get_name() }}</caption>
	<label>figure:{{ ag.get_id() }}_skill_tree</label>
      </figure>
      {% endif %}

      {% for ability in ag.get_abilities()%}
      {{ build_ability(ability) }}
      {% endfor %}
    </subsection>
    {% endfor %}

 
    {% for ag in ability_groups
       if ag.get_family_id() == db.ABILITY_FAMILY_WYRDSCIENCE_ID %}
   <subsection>
      <subsectiontitle>{{ ag.get_name() }}</subsectiontitle>
      {{ ag.get_description() }}

      {% if ag.has_abilities() %}
      <figure position="h" fullwidth="false" sideways="false">
	<img buildfname="{{ ag.get_id() }}_skill_tree.pdf"/>
	<caption>{{ ag.get_name() }}</caption>
	<label>figure:{{ ag.get_id() }}_skill_tree</label>
      </figure>
      {% endif %}

      {% for ability in ag.get_abilities()%}
      {{ build_ability(ability) }}
      {% endfor %}
    </subsection>
    {% endfor %}
  </section>

  

  <section>
    <sectiontitle>Martial Abilities</sectiontitle>
    <epigraph>Nobody loves a warrior until the enemy is at the gate</epigraph>
    <p>
      <indexentry>
	<entry>Abilities</entry>
	<subentry>Martial</subentry>
      </indexentry>
      represents combat related physical skills, <eg/> Axe Strike, Shield
      Block.
    </p>

    <indexentry>
      <entry>Opponents</entry>
      <subentry>Defence</subentry>
    </indexentry>
    <indexentry>
      <entry>Opponents</entry>
      <subentry>Attack</subentry>
    </indexentry>
    <p>
      Many martial abilities have a DC based on the Opponents Defence, this
      means the targets Block, Parry, Armour or other defensive ability check
      amount or difficulty. Other martial abilities are checked against a DC
      based on the opponents attack. This represents that attack skill check
      result or DC for the opponent. For example a monster may attack a
      character with a Sword with an attack with DC 15. The PC then uses the
      monsters attack DC as the Opponents Attack DC in any defensive skill the
      character uses against the attack.
    </p>


    {% for ag in ability_groups
       if ag.get_family_id() == db.ABILITY_FAMILY_MARTIAL_ID %}
    <subsection>
      <subsectiontitle>{{ ag.get_name() }}</subsectiontitle>
      {{ ag.get_description() }}

      {% if ag.has_abilities() %}
      <figure position="h" fullwidth="false" sideways="false">
	<img buildfname="{{ ag.get_id() }}_skill_tree.pdf"/>
	<caption>{{ ag.get_name() }}</caption>
	<label>figure:{{ ag.get_id() }}_skill_tree</label>
      </figure>
      {% endif %}

      {% for ability in ag.get_abilities()%}
      {{ build_ability(ability) }}
      {% endfor %}
    </subsection>
    {% endfor %}
  </section>

  <section>
    <sectiontitle>General Abilities</sectiontitle>
    <p>
      <indexentry>
	<entry>Abilities</entry>
	<subentry>General</subentry>
      </indexentry>
      These abilities represent trade-craft and creative abilities: Smithing,
      Animal Handling, Playing Music, Hunting and so on.
    </p>

    {% for ag in ability_groups
       if ag.get_family_id() == db.ABILITY_FAMILY_GENERAL_ID %}
    <subsection>
      <subsectiontitle>{{ ag.get_name() }}</subsectiontitle>
      {{ ag.get_description() }}

      {% if ag.has_abilities() and ag.draw_skill_tree() %}
      <figure position="h" fullwidth="false" sideways="false">
	<img buildfname="{{ ag.get_id() }}_skill_tree.pdf"/>
	<caption>{{ ag.get_name() }}</caption>
	<label>figure:{{ ag.get_id() }}_skill_tree</label>
      </figure>
      {% endif %}

      {% for ability in ag.get_abilities()%}
      {{ build_ability(ability) }}
      {% endfor %}
    </subsection>
    {% endfor %}
  </section>

  {# SECTION MAGICAL ABILITIES #}
  {% include "docs/fragment_magical_abilities.xml" %}
  
</chapter>

