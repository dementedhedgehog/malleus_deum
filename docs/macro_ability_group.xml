{% macro format_ability_group(ag) %}
<subsection>
  <subsectiontitle>{{ ag.get_name() }}</subsectiontitle>
  {% set slug = ag.get_slug() -%}
  {%- if slug -%}
  <slug>{{ slug }}</slug>
  {%- endif -%}
  
  {{- ag.get_description() -}}
  
  {% if ag.has_abilities() and ag.draw_skill_tree() %}
  <figure position="h" fullwidth="false" sideways="false">
    <img buildfname="{{ ag.get_id() }}_skill_tree.pdf"/>
    <caption>{{ ag.get_name() }}</caption>
    <label>figure:{{ ag.get_id() }}_skill_tree</label>
  </figure>
  {% endif -%}
    
  {% for ability in ag.get_abilities()%}
  {{ format_ability(ability) }}
  {% endfor %}
</subsection>
{%- endmacro -%}
