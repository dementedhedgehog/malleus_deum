  <ability>
    <abilitytitle>Sword Strike</abilitytitle>
    <abilityid>sword_strike</abilityid>    
    <abilityranks untrained="-3" from="1" to="6"/>
    <action>
      <name>Melee-Attack</name>   
      <critclass><melee-attack/></critclass>
      <cost><ap4/></cost>
      <range><reach/></range>
      <keywords><basic-attack/><check/></keywords>
      <opposing-action><physical-defence/></opposing-action>
      <dmg>Weapon+Rank+Strength|Speed</dmg>
      <critsuccess><default-attack-critical-success/></critsuccess>
      <righteoussuccess><default-attack-righteous-success/></righteoussuccess> 
      <success><default-attack-success/></success>
    </action>
    <spline></spline>
    <abilitydescription>
      <p noindent="true">
        Characters equipped with a Sword can strike with it during
	combat doing weapon damage.
      </p>
    </abilitydescription>
  </ability>
</abilitygroup>
