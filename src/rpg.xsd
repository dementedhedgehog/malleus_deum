      <!--
	  Ritual spell
	  Can't be done in combat.. constrains apcost 
      -->
      <xs:element name="ritual" type="keywordType" fixed="Ritual"/>



      <!-- Antagonist ability only -->
      <!-- <xs:element name="aspect" type="keywordType" fixed="Antagonist"/> -->
      
      <xs:element name="deferred-check" type="keywordType" fixed="Deferred Check"/>

      <!--
	  This ability is one of the primary attacks for the weapon type
	  (triggers bonus attacks).  That means it does the standard outcomes:
	  righteous-success=2xdmg etc. 
      -->
      <xs:element
	  name="basic-attack"
	  type="keywordType"
	  fixed="Basic-Attack"/>

      <!--
	  Check made with advantage or disadvantage (on skill)
      -->
      <xs:element name="advantage" type="keywordType" fixed="Advantage"/>
      <xs:element name="disadvantage" type="keywordType"  fixed="Disadvantage"/>
      
      <!--
	  These pair of keywords denote 'normal' (non-magical) attack and
	  defence checks.  A 'physical-attack' check may usually be countered
	  with a 'physical-defence' counter check.

          The keywords unblockable, undodgeable, unparryable, and noarmour may
	  be used to exclude certain defence counterchecks for a check,
	  e.g. you can't dodge a bullet.
      -->
      <xs:element
	  name="physical-attack"
	  type="keywordType"
	  fixed="Physical-Attack"/>
      <xs:element
	  name="physical-defence"
	  type="keywordType"
	  fixed="Physical-Defence"/>
      

      <!-- Different types of Area Of Effect -->
      <xs:element name="aoe-emination" type="keywordType" fixed="Emination"/>
      <xs:element name="aoe-cone" type="keywordType" fixed="Cone"/>
      <xs:element name="aoe-ray" type="keywordType" fixed="Ray"/>

      <!-- Different save types -->
      <xs:element
	  name="everyone-saves"
	  type="keywordType"
	  fixed="Everyone-Saves"/>
      <xs:element
	  name="delegate-saves"
	  type="keywordType"
	  fixed="Delegate-Saves"/>
      
      <!--
	  All checks must either be Checks, Counterchecks or Auxiliarys.
	  Each Check is opposed by a CounterCheck
	  Auxilaries are triggers for other actions.
      -->
      <xs:element
	  name="check"
	  type="keywordType"
	  fixed="Check"/>
      <xs:element
	  name="countercheck"
	  type="keywordType"
	  fixed="Counter-Check"/>
      <xs:element
	  name="auxiliary"
	  type="keywordType"
	  fixed="Auxiliary"/>

      
      <!-- Spells which are open to interpretation (FIXME: RENAME gm-fiat?? or similar) -->
      <xs:element
	  name="versatile"
	  type="keywordType"
	  fixed="Versatile"/>

      <!-- Requires the minor action to keep going each round -->
      <xs:element
	  name="maintain"
	  type="keywordType"
	  fixed="Maintain"/>

      <!-- dice pool abilities -->
      <xs:element
	  name="luckpool"
	  type="keywordType"
	  fixed="Luck-Pool"/>
      <xs:element
	  name="mettlepool"
	  type="keywordType"
	  fixed="Mettle-Pool"/>
      <xs:element
	  name="magicpool"
	  type="keywordType"
	  fixed="Magic-Pool"/>
    </xs:choice>    
  </xs:complexType>


  
    

