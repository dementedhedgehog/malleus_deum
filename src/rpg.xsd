      <xs:element name="hfill" type="textType"/>
    </xs:choice>
    <!-- <xs:attribute name="token_type" type="xs:string" fixed="ignore-text"/> -->
  </xs:complexType>  


  <xs:complexType name="attributionType">
  </xs:complexType>

  <xs:complexType name="inspirationType">
  </xs:complexType>

