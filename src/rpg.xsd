<?xml version="1.0"?>
<!-- -*-xml-*-

This is the XSD Schema for all the xml documents in the project.
We use this to verify our xml and to define constants.


Naming convention.. (we don't comply yet)
   - Groups should always be named somethingGroup
   - Types are called somethingType or somethingEnum 
   - xsd 'fixed' attributes are used quite a bit to encode constant human
     readable values for various types etc to ameliorate limitations with 
     what xsd can specify.

     
Token Types:
   * alias - replace this element with a different element before formatting
   * keyword - a text constant bold formated 
   * text-constant - a text constant formated as normal text
   * ignore-text - tells the doc.format *not* to parse node.text from this
   element.  Instead let the underlying formatter worry about formatting this
   element.  The parser will still parse children


 WARNING:
   Because we encode information about how elements should be parsed in this
   xsd it's possible to change the format of the docs generated if you fiddle
   with this xml, the "type" field in particular.


 WARNING:
   Because we parse this document as an XML document, in order to extract
   constants for python, changing the names of elements can break things.
   Specifically the names for the types which are big sets of
   KeywordType declarations, i.e. avoid renaming the blahEnum elements unless
   you're careful about it.
     
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">    

  <!--
      Used for elements that should never have content but don't have any
      more specialized semantics, e.g. <hline/>.
  -->
  <xs:complexType name="emptyType"/>

  <!--
      Elements that should never have content, that drop in character symbols,
      like arrows, ampersand, percent etc. Things that the various processing
      steps won't deal with cleanly (e.g. special chars for latex and xml).
  -->
  <xs:complexType name="symbolType"/>

  <!--
      Float strictly > 0.0 .. for metrics
  -->
  <xs:simpleType name="positiveFloat">
    <xs:restriction base="xs:float">
      <xs:minExclusive value="0"/>
    </xs:restriction>
  </xs:simpleType>


  <!--
      Doc.format() should stop processing at this node.  Don't bother handling
      it any further, leave it up to the underlying formatters to deal with.
  -->      
  <xs:complexType name="atomType">
    <xs:attribute name="token_type" type="xs:string" fixed="atom"/>
  </xs:complexType>
  

  <!--
      A simple text node that we don't want the formatter to worry about.

      Doc.format() should stop processing at this node.  Don't bother handling
      it any further, leave it up to the underlying formatters to deal with.
  -->      
  <xs:complexType name="leafType">
    <xs:simpleContent>
      <xs:extension base="xs:string">
	<xs:attribute name="token_type" type="xs:string" fixed="ignore-text"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>
  
  <!--
      XSD doesn't have constants  and we kind of want them so we can constrain
      acceptable values in our "db" to members of groups.  The difference
      between keywords and string constants is that the formatter is told to
      format the keywords as keywords, and to format string constants as normal
      text.

      E.g. define an element as follows in this XSD file.
      <xs:element name="default-lore-sv-easy" type="aliasType" fixed="sv11"/>
      <xs:element
	  name="physical-defence"
	  type="ctringConstantType"
	  fixed="Physical Defence"/>
      
      then in the document this:
      <physical-defence/> 

      will be replaced by this:
      "Physical Defence"
      before any further processing. So the substitution happens before any
      formatting.

  -->
  <xs:complexType name="stringConstantType">
    <xs:simpleContent>
      <xs:extension base="xs:string">
	<xs:attribute
	    name="token_type"
	    type="xs:string"
	    fixed="string-constant"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  
  <!--
      Elements that are keywords

      Anything defined like this is EXPECTED to have a 'fixed'
      attribute set in this xsd.  (The fixed attribute in an
      xsd is a mandatory default text body that the xml will insert as
      the 'text' value).  So put a HUMAN READABLE STRING in the
      fixed value for keywords.
 
      For example if we define
      <xs:element
          name="reaction-interrupt"
          type="keywordType"
	  fixed="Reaction Interrupt"/> 

      then these values look like, e.g. <reaction-interrupt/> in the
      xml and their element.tag is "reaction-interrupt" but their
      element.text is "Reaction Interrupt".
  -->
  <xs:complexType name="keywordType">
    <xs:simpleContent>
      <xs:extension base="xs:string">
	<xs:attribute name="token_type" type="xs:string" fixed="keyword"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>
  

  <!--
      XSD doesn't have aliases and we kind of want them to avoid duplicating
      data all over the place, we'd rather have aliases for certain default
      values. So any alias element gets replaced by a node named after it's text
      when parsing.  Specify the text in a fixed field.

      E.g. define an element as follows in this XSD file.
      <xs:element name="default-lore-sv-easy" type="aliasType" fixed="sv11"/>

      then in the document this:
      <default-lore-sv-easy/> 

      will be replaced by this:
      <sv11/> 
      before any further processing. So the substitution happens before any
      formatting.

  -->
  <xs:complexType name="aliasType">
    <xs:simpleContent>
      <xs:extension base="xs:string">
	<xs:attribute name="token_type" type="xs:string" fixed="alias"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  
  <!--
      This is the type for the type of ornament called a page divider or sometimes
      dotted line.  They're little lines used to separate blocks of text.  They
      look a little bit like this in documents (for example):

                  -»»————-(★)-————««-

  -->
  <xs:complexType name="dividerType">
    <xs:attribute name="type" default="standard">
      <xs:simpleType>
	<xs:restriction base="xs:string">
          <xs:enumeration value="standard"/>
          <xs:enumeration value="fancy"/>
	</xs:restriction>
      </xs:simpleType>
    </xs:attribute>    
  </xs:complexType>

  <!--
      Newline with customizable skip
  -->
  <xs:complexType name="brType">
    <xs:attribute name="length" type ="xs:float"/>
  </xs:complexType>
  

  <!-- IDs -->
  <xs:simpleType name="idType">
    <xs:restriction base="xs:NCName"/>
  </xs:simpleType>

  <xs:simpleType name="abilityidType">
    <xs:restriction base="xs:NCName"/> 
  </xs:simpleType>

  <xs:complexType name="hlinkType">
    <xs:simpleContent>
      <xs:extension base="xs:string">
	<xs:attribute name="url" type="xs:string" use="required"/>
	<xs:attribute name="token_type" type="xs:string" fixed="ignore-text"/>	
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  
  <xs:complexType name="abilityrefType">
    <xs:attribute name="id" type="xs:string" use="required"/>
    <xs:attribute name="rank" type="xs:int" use="optional"/>

    <!--
	Specializations are a list of comma separated values each value is a
	specialization name followed by an optional :rank (where each rank of
	specialization counts as a +3 to the underlying value).
    -->
    <xs:attribute name="specializations" type="xs:string"/>
    
    <!-- for paramaterized ability refs attacks (for antagonists) -->
    <xs:attribute name="dmg" type="xs:int" use="optional"/>
  </xs:complexType>

  <!-- skill graphs -->
  <xs:complexType name="pointType">
    <xs:attribute name="x" type="xs:int" />
    <xs:attribute name="y" type="xs:int" />
  </xs:complexType>

  <xs:complexType name="splineType">
    <xs:sequence>
      <xs:element name="p" type="pointType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>
  <!-- end skill graphs -->

  <!--
      Long form measurement type
      Based on the settings in config substitutes either imperial or metric text

      FIXME: use lengthMeasurementType when it makes sense!! (For readability/compactness)
      FIXME: use weights with weightMeasurementType when it makes sense!! (currently undefined)
  -->
  <!-- <xs:complexType name="measurementType" > -->
  <!--   <xs:all> -->
  <!--     <xs:element name="imperial" type="xs:string" minOccurs="1" maxOccurs="1"/> -->
  <!--     <xs:element name="metric" type="xs:string" minOccurs="1" maxOccurs="1"/> -->
  <!--   </xs:all>  -->
  <!--   <xs:attribute name="token_type" type="xs:string" fixed="atom"/> -->
  <!-- </xs:complexType> -->

  <xs:complexType name="measurementType" >
    <xs:complexContent>
      <xs:extension base="atomType">
	<xs:all>
	  <xs:element name="imperial" type="xs:string" minOccurs="1" maxOccurs="1"/>
	  <xs:element name="metric" type="xs:string" minOccurs="1" maxOccurs="1"/>
	</xs:all> 
      </xs:extension>
    </xs:complexContent>    
  </xs:complexType>

  <xs:simpleType name="nullOrIntType">
    <xs:restriction base="xs:string">
      <xs:pattern value="\d*|\s{0}" />
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="encounterMonsterType">
