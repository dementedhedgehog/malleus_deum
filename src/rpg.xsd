      <xs:element name="km3">
	<xs:complexType>
	  <xs:attribute name="metric" type="xs:string" fixed="3 kilometers"/>
	  <xs:attribute name="imperial" type="xs:string" fixed="2 miles"/>
	</xs:complexType>
      </xs:element>
    </xs:choice>
  </xs:group>


  <xs:complexType name="lengthMeasurementType">
    <xs:choice>
      <xs:group ref="lengthMeasurementGroup"/>
    </xs:choice>
  </xs:complexType>
  

  
