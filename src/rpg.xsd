	  minOccurs="0" maxOccurs="1"/>

      <!-- Brief intro to the ability (one or two lines) -->
      <xs:element name="slug" type="textType" minOccurs="0" maxOccurs="1"/>

      <!-- Protag Abilities must have ranks, Antag Abilities must not. -->
      <xs:element
	  name="abilityranks"
	  type="abilityranksType"
	  minOccurs="0" maxOccurs="1"/>

      <!--
	  To perform an ability may require somewhere between 0 and 3 checks
      -->
      <xs:element
	  name="keywords"
	  type="abilityKeywordsType"
	  minOccurs="0"
	  maxOccurs="1"/>

      <!-- Ability Check types -->
      <xs:sequence  minOccurs="0" maxOccurs="unbounded">
	<xs:choice>
	  <xs:element name="abilitycheck" type="checkType"/>
	  <xs:element name="abilitycountercheck" type="counterCheckType"/>
	  <xs:element name="abilityauxiliary" type="abilityCheckAuxiliaryType"/>
	</xs:choice>
      </xs:sequence>

      <!-- <xs:element name="prereqabilityrank" type="prerequisiteType" minOccurs="0" maxOccurs="1"/> -->
      <xs:element name="prereqabilityref" type="abilityrefType" minOccurs="0" maxOccurs="1"/>
      <xs:element name="prereqtag" type="xs:string" minOccurs="0"/>
      <xs:element name="prereqnottag" type="xs:string" minOccurs="0"/>
      <xs:element name="prereqattr" type="prereqAttrType" minOccurs="0"/> <!-- e.g. Str > 13 -->
      <!--
	  Information about how to layout this ability in the abilities tree
      -->
      <xs:element name="spline"
		  type="splineType"
		  minOccurs="0" maxOccurs="1"/>
      
      <xs:element name="specializations"
		  type="specializationsType"
		  minOccurs="0" maxOccurs="1"/>
      
      <xs:element name="stage"
		  type="abilityStageType"
		  minOccurs="0" maxOccurs="unbounded"/>
      
      <xs:element name="abilitydescription"
		  type="blockType"
		  minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>


  <xs:complexType name="specializationsType">
    <xs:sequence>
      <xs:element name="specialization" type="xs:string" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="abilityranksType">
    <xs:attribute name="untrained" type="xs:int"/>
    <xs:attribute name="from" type="xs:int" />
    <xs:attribute name="to" type="xs:int" />
  </xs:complexType>

  <xs:complexType name="opposedType">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="checktype" type="xs:string" fixed="opposed"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>
  
  <xs:complexType name="unopposedType">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="checktype" type="xs:string" fixed="unopposed"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>
      
  

  <!-- Used for Antag Check Results and for Antag/Protag Counter Results -->
  <xs:group name="svResultGroup">
    <xs:choice>
      <!-- <xs:element name="gm-fiat" type="emptyType"/> -->
      <!-- <xs:group ref="abilityParamGroup"/> -->
      
      <xs:element name="param-check" type="stringConstantType" fixed="CHECK"/>

      <xs:element name="sv3" type="symbolType"/>
      <xs:element name="sv5" type="symbolType"/>
      <xs:element name="sv7" type="symbolType"/>
      <xs:element name="sv9" type="symbolType"/>
      <xs:element name="sv11" type="symbolType"/>
      <xs:element name="sv13" type="symbolType"/>
      <xs:element name="sv15" type="symbolType"/>
      <xs:element name="sv17" type="symbolType"/>
      <xs:element name="sv19" type="symbolType"/>
      <xs:element name="sv21" type="symbolType"/>
      <xs:element name="sv23" type="symbolType"/>
      <xs:element name="sv25" type="symbolType"/>
      <xs:element name="sv27" type="symbolType"/>
      <xs:element name="sv29" type="symbolType"/>

      
    </xs:choice>
  </xs:group>

  <xs:complexType name="svResultType">
    <xs:sequence>
      <xs:group ref="svResultGroup" minOccurs="0" maxOccurs="1"/>
    </xs:sequence>
  </xs:complexType>
  
  <!-- <xs:group name="resultGroup"> -->
  <!--   <xs:choice> -->
  <!--     <xs:element name="d20plusrank" type="emptyType"/>       -->
  <!--   </xs:choice> -->
  <!-- </xs:group> -->

  <!--
      These are possible counterchecks against a check.
      E.g. when skill is X vs Y then these define the allowed Y's.
  -->
  <xs:group name="opponentsCounterResultGroup">
    <xs:choice>

      <!-- <xs:group ref="defaultResultGroup"/> -->
      
      <!-- For PC defend actions -->
      <xs:element
	  name="opponents-physical-attack"
	  type="stringConstantType"
	  fixed="Physical Attack"/>
      
      <!-- For PC attack actions -->
      <xs:element
	  name="opponents-physical-defence"
	  type="stringConstantType"
	  fixed="Physical Defence"/>
      
      <xs:element
	  name="opponents-physical-defence-or-gm-fiat"
	  type="stringConstantType"
	  fixed="Physical Defence or GM's Fiat"/>
      
      <!-- For various opposed checks -->
      <xs:element
	  name="opponents-strength-save"
	  type="stringConstantType"
	  fixed="Strength Save"/>
      
      <xs:element
	  name="opponents-agility-save"
	  type="stringConstantType"
	  fixed="Agility Save"/>
      <xs:element
	  name="opponents-speed-save"
	  type="stringConstantType"
	  fixed="Speed Save"/>
      <xs:element
	  name="opponents-perception-save"
	  type="stringConstantType"
	  fixed="Perception Save"/>
      <xs:element
	  name="opponents-speed-or-perception-save"
	  type="stringConstantType"
	  fixed="Speed or Perception Save"/>
      <xs:element
	  name="opponents-will-save"
	  type="stringConstantType"
	  fixed="Will Save"/>      
      <xs:element
	  name="opponents-mettle-save"
	  type="stringConstantType"
	  fixed="Mettle Save"/>
      <xs:element
	  name="opponents-endurance-save"
	  type="stringConstantType"
	  fixed="Endurance Save"/>
      <xs:element
	  name="opponents-endurance-or-willpower-save"
	  type="stringConstantType"
	  fixed="Endurance or Willpower Save"/>
      <xs:element
	  name="opponents-luck-save"
	  type="stringConstantType"
	  fixed="Luck Save"/>
      
      <xs:element
	  name="opponents-negotiate-save"
	  type="stringConstantType"
	  fixed="Negotiate Save or GM Fiat"/>
      
      <xs:element
	  name="opponents-etiquette-save"
	  type="stringConstantType"
	  fixed="Etiquette Save or GM Fiat"/>
          
      <!-- NPC/Hazard/GM opposed abilities -->
      <xs:element name="gm-fiat" type="stringConstantType" fixed="GM Fiat"/>

      <xs:element name="aspect-sv" type="aliasType" fixed="sv9"/>
      <xs:element name="default-lore-sv-easy" type="aliasType" fixed="sv9"/>
      <xs:element name="default-lore-sv" type="aliasType" fixed="sv11"/>
      <xs:element name="default-lore-sv-hard" type="aliasType" fixed="sv13"/>
      <xs:element name="default-transport-sv" type="aliasType" fixed="sv11"/>
      <xs:element name="default-physical-sv" type="aliasType" fixed="sv11"/>
      <xs:element name="default-craft-sv" type="aliasType" fixed="sv11"/>
      <xs:element name="default-language-sv" type="aliasType" fixed="sv11"/>
      <xs:element name="default-language-sv-hard" type="aliasType" fixed="sv13"/>
    </xs:choice>
  </xs:group>


  <xs:complexType name="poolCostType" mixed="true">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:group ref="textEnum"/>
    </xs:choice>
    <xs:attribute name="noindent" type="xs:boolean" default="false"/>
  </xs:complexType>  


  <xs:group name="abilityCheckEnum">
    <xs:choice>
      <!-- Uses svv, and recall knowledge crit table -->
      <xs:element name="recall-knowledge" type="keywordType" fixed="Recall Knowledge"/>
      <xs:element name="language" type="keywordType" fixed="Language"/>      
      <!--
	  Uses targets defence or will, and does hp damage.
          righteous and critical do +dmg and +2dmg
          This should include things that do extra effects like Eldritch Push
      -->
      <xs:element name="magic-attack" type="keywordType" fixed="Magic Attack"/>
      <!-- Checks for consumable supply -->
      <xs:element name="supply" type="keywordType" fixed="Supply"/>
      <!-- Uses a SSV, Magic Crit Table -->
      <xs:element name="cast" type="keywordType" fixed="Cast"/>
      <!-- Art/Music etc -->
      <xs:element name="perform" type="keywordType" fixed="Perform"/>
      <!-- Willpower or Luck Test. has an associated pool and a cost? -->
      <xs:element name="trial" type="keywordType" fixed="Trial"/>
      <!-- Simple check...  has no point pool cost -->
      <xs:element name="test" type="keywordType" fixed="Test"/>
      <xs:element name="physical" type="keywordType" fixed="Physical"/>
      <!-- Simple check...  -->
      <xs:element name="social" type="keywordType" fixed="Social"/>
      <!-- righteous and critical do +dmg and +2dmg -->
      <xs:element name="melee-attack" type="keywordType" fixed="Melee Attack"/>
      <!-- eg shield block -->
      <xs:element name="physical-defence" type="keywordType" fixed="Physical Defence"/>

      <xs:element name="armour" type="keywordType" fixed="Armour"/>
      <xs:element name="dodge" type="keywordType" fixed="Dodge"/>
      <xs:element name="parry" type="keywordType" fixed="Dodge"/>
      <xs:element name="aspect" type="keywordType" fixed="FIXME"/>      
      <!--
	  righteous and critical do +dmg and +2dmg
          Ranged Crit table
      -->
      <xs:element name="missile-attack" type="keywordType" fixed="Missile Attack"/>      
      <xs:element name="craft" type="keywordType" fixed="Craft"/>
      <xs:element name="fixme" type="keywordType" fixed="FIXME"/>      
      <xs:element name="auxiliary" type="keywordType" fixed="Auxiliary"/>


      <xs:element name="custom" type="keywordType" fixed="Custom Outcomes"/>
      
      <!-- Aspects -->
      <!-- <xs:element name="quirk" type="keywordType" fixed="Missile Attack"/>       -->
    </xs:choice>
  </xs:group>


  <!-- -->
  <xs:complexType name="abilityCheckType" mixed="false">
      <xs:group ref="abilityCheckEnum"/>
  </xs:complexType>
  
  <xs:group name="abilityRequiresEnum">
    <xs:choice>
      <xs:element name="alchemical-lab" type="keywordType"
		  fixed="Alchemical Lab"/>
      <!-- <xs:element name="" type="keywordType" fixed="Language"/> -->
    </xs:choice>
  </xs:group>

  <!-- -->
  <xs:complexType name="abilityRequiresType" mixed="false">
      <xs:group ref="abilityRequiresEnum"/>
  </xs:complexType>
  

  
  <!--

   Items (Magic, Poison etc).

  -->
  <xs:complexType name="itemKeywordsType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="potion" type="keywordType" fixed="Potion"/>
      <xs:element name="rod" type="keywordType" fixed="Rod"/>
    </xs:choice>
  </xs:complexType>
  

  <xs:complexType name="itemType" mixed="false">
    <xs:sequence>
      <xs:element
	  name="initial-pool"
	  type="xs:positiveInteger"
	  minOccurs="0" maxOccurs="1"/>
      <xs:element
	  name="keywords"
	  type="itemKeywordsType"
	  minOccurs="0"
	  maxOccurs="1"/>

      <!-- Check types -->
      <xs:sequence  minOccurs="0" maxOccurs="unbounded">
	<xs:choice>
	  <xs:element name="check" type="checkType"/>
	  <xs:element name="countercheck" type="counterCheckType"/>
	  <xs:element name="auxiliary" type="abilityCheckAuxiliaryType"/>
	</xs:choice>
      </xs:sequence>      
    </xs:sequence>
  </xs:complexType>


  <!-- 
    <descriptions>
      <term>Type</term><description>Book</description>
      <term>Pool</term><description></description>
      <term>Refresh</term><description></description>
      <term>Difficulty</term><description></description>
    </descriptions>    

    -->
  
  <!-- <xs:complexType name="textType" mixed="true"> -->
  <!--   <xs:choice minOccurs="0" maxOccurs="unbounded"> -->
  <!--     <xs:group ref="textEnum"/> -->
  <!--   </xs:choice> -->
  <!--   <xs:attribute name="noindent" type="xs:boolean" default="false"/> -->
  <!-- </xs:complexType>   -->
  
  <!--
      
    Various different types of check have different sets of fields that are allowed.
    However *ALL* checks share these header fields.

  -->
  <xs:group name="abilityCheckHeaderGroup">
    <xs:sequence>
      <!-- The name of the check.  One of a few standard types or <special/> -->
      <xs:element name="name" type="leafType" minOccurs="1" maxOccurs="1"/>

      <!-- This value used to determine behaviour in the event of a crit success or crit fail -->
      <xs:element name="checktype" type="abilityCheckType" minOccurs="1" maxOccurs="1"/>

      <!-- Point Pool cost to make the check -->
      <xs:element name="poolcost" type="poolCostType" minOccurs="0" maxOccurs="1"/>
      
      <!-- Action economy information -->
      <xs:element name="apcost" type="abilityAPCostType" minOccurs="1" maxOccurs="1"/>

      <!-- Action economy information -->
      <xs:element name="requires" type="abilityRequiresType" minOccurs="0" maxOccurs="1"/>

      <!-- what range the ability works at. -->
      <xs:element name="range" type="rangeEnum" minOccurs="1" maxOccurs="1"/>
      <xs:element name="keywords" type="abilityKeywordsType" minOccurs="1" maxOccurs="1"/>      

      <!-- some abilities can only be used after certain preconditions are met -->
      <xs:element name="precondition" type="xs:string" minOccurs="0" maxOccurs="1"/>

      <!-- Some abilities cause other checks or abilities to be used. They're specified here. -->
      <xs:element name="effect" type="textType" minOccurs="0" maxOccurs="1"/>
    </xs:sequence>
  </xs:group>


  <!--

   Skill and Fate Outcomes..

  -->
  <xs:group name="outcomeAliasEnum">
    <xs:choice>
      <xs:element
	  name="default-lore-critical-success"
	  fixed="Know four true things."/>
      <xs:element
	  type="stringConstantType"
	  name="default-lore-righteous-success"
	  fixed="Know three true things."/>      
      <xs:element
	  name="default-lore-success"
	  fixed="Know two true things."/>

      <xs:element
	  name="default-attack-critical-success"
	  fixed="3×Dmg"/>
      <xs:element
	  name="default-attack-righteous-success"
	  fixed="2×Dmg"/>      
      <xs:element
	  name="default-attack-success"
	  fixed="Dmg"/>      
      
      <xs:element
	  name="default-language-critical-success"
	  fixed="XXX"/>
      <xs:element
	  name="default-language-righteous-success"
	  fixed="XXXY"/>      
      <xs:element
	  name="default-language-success"
	  fixed="XXXZ"/>
      <xs:element
	  name="default-craft-critical-success"
	  fixed="XXX"/>
      <xs:element
	  name="default-craft-righteous-success"
	  fixed="XXXY"/>
      <xs:element
	  name="default-craft-success"
	  fixed="XXXZ"/>
    </xs:choice>
  </xs:group>

  <xs:complexType name="outcomeTextType" mixed="true">
    <xs:choice minOccurs="1" maxOccurs="unbounded">
      <xs:group ref="outcomeAliasEnum"/>
      <xs:group ref="textEnum"/>
    </xs:choice>
    <xs:attribute name="token_type" type="xs:string" fixed="ignore-text"/>    
  </xs:complexType>  
    
  
  <!-- How to interpret the result of the fate/skill dice for a check -->
  <xs:group name="abilityCheckOutcomeGroup">
    <xs:sequence>
      <xs:element name="any-success" type="outcomeTextType" minOccurs="0" maxOccurs="1"/>
      <xs:element name="critsuccess" type="outcomeTextType" minOccurs="0" maxOccurs="1"/>
      <xs:element name="righteoussuccess" type="outcomeTextType" minOccurs="0" maxOccurs="1"/>
      <xs:element name="success" type="outcomeTextType" minOccurs="0" maxOccurs="1"/>
      <xs:element name="any-fail" type="outcomeTextType" minOccurs="0" maxOccurs="1"/>
      <xs:element name="fail" type="outcomeTextType" minOccurs="0" maxOccurs="1"/>
      <xs:element name="grimfail" type="outcomeTextType" minOccurs="0" maxOccurs="1"/>
      <xs:element name="critfail" type="outcomeTextType" minOccurs="0" maxOccurs="1"/>
      <xs:element name="damned" type="textType" minOccurs="0" maxOccurs="1"/>
      <xs:element name="cursed" type="textType" minOccurs="0" maxOccurs="1"/>
      
      <!-- <xs:element name="gm-fiat" type="emptyType" minOccurs="0" maxOccurs="1"/> -->
    </xs:sequence>
  </xs:group>
  

  <!-- Check -->  
  <xs:complexType name="checkType" mixed="true">
    <xs:sequence>
      <xs:group ref="abilityCheckHeaderGroup"/>
      <xs:element name="counter" minOccurs="1" maxOccurs="1">
	<xs:complexType>
	  <xs:choice>
	    <xs:group ref="svResultGroup"/>
	    <xs:group ref="opponentsCounterResultGroup"/>
	  </xs:choice>
	</xs:complexType>
      </xs:element>

      <xs:element name="dmg" minOccurs="0" maxOccurs="1">
	<xs:complexType mixed="true">
	  <xs:sequence>
	    <xs:element
		name="param-dmg"
		type="stringConstantType"
		fixed="DMG"
		minOccurs="0" maxOccurs="1"/>
	  </xs:sequence>
	</xs:complexType>
      </xs:element>
	
      <xs:group ref="abilityCheckOutcomeGroup"/>
    </xs:sequence>
    <xs:attribute name="readable-type" type="xs:string" fixed="Check"/>    
  </xs:complexType>
  

  <!-- Protagonist CounterCheck (Save) -->
  <xs:complexType name="counterCheckType" mixed="false">
    <xs:sequence>
      <xs:group ref="abilityCheckHeaderGroup"/>
      <xs:element name="counter" minOccurs="1" maxOccurs="1">
	<xs:complexType>
	  <xs:choice>
	    <xs:group ref="svResultGroup"/>
	    <xs:group ref="opponentsCounterResultGroup"/>
	  </xs:choice>
	</xs:complexType>
      </xs:element>
      
      <xs:group ref="abilityCheckOutcomeGroup"/>
    </xs:sequence>    
    <xs:attribute name="readable-type" type="xs:string" fixed="Countercheck"/>
  </xs:complexType>

  <!-- Triggered by another check but doesn't require a roll. -->
  <xs:complexType name="abilityCheckAuxiliaryType" mixed="false">
    <xs:sequence>
      <xs:group ref="abilityCheckHeaderGroup"/>
    </xs:sequence>
    <xs:attribute name="readable-type" type="xs:string" fixed="Auxiliary"/>    
  </xs:complexType>

  <xs:complexType name="tableType">
    <xs:sequence>
      <!-- Optional element that determines table layout. -->
      <xs:choice minOccurs="0" maxOccurs="1">
	<!-- standard table.. one column, fixed placement, the default if nothing is specified-->
	<xs:element name="standardtable" type="symbolType"/>
	<!-- Table is two columns wide -->
	<xs:element name="fullwidthtable" type="symbolType"/>
	<!-- Table is a figure (it's placed in the document that looks nice and is nearby) -->
	<xs:element name="figuretable" type="symbolType"/>
	<!-- Table is sideways .. this implies it's also a figure and fullwdith -->
	<xs:element name="sidewaystable" type="symbolType"/>
      </xs:choice>

      <!-- Specifies the number of columns and how wide they are -->
      <xs:element name="tablespec" type="tablespecType" minOccurs="1" maxOccurs="1"/>
      <xs:element name="tabletitle" type="textType" minOccurs="0" maxOccurs="1"/>
      <xs:element name="tablelabel" type="leafType" minOccurs="0" maxOccurs="1"/>
      <xs:element name="indexentry" type="indexentryType" minOccurs="0" maxOccurs="unbounded"/>
      
      <xs:choice minOccurs="0" maxOccurs="unbounded">
      	<xs:element name="tableheaderrow" type="tableRowType" minOccurs="0" maxOccurs="unbounded"/>
      	<xs:element name="tablerow" type="tableRowType" minOccurs="1" maxOccurs="unbounded"/>
        <xs:element name="hline" type="emptyType"/>
      </xs:choice>
    </xs:sequence>
    
    <!--
	Change the space between columns .. e.g. use something like 0.95
	Use this if you're having some problems fitting your table content
	horizontally.
    -->
    <xs:attribute name="colsep" type="xs:decimal"/>
    <xs:attribute name="token_type" type="xs:string" fixed="ignore-text"/>
  </xs:complexType>

  <xs:complexType name="fixedColumnType">
    <xs:simpleContent>
      <!--
	  The width of the column as a proportion of the width of the table.
	  Note that space is added around the table so the sum of the fixed
	  columns should be a bit less than 1.0 to account for this.  For
	  example, for a table with 5 equal width columns try a proportion
	  of 0.19 for each colummn as a starting point.
      -->	  
      <xs:extension base="xs:decimal">
	<xs:attribute name="token_type" type="xs:string" fixed="ignore-text"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>
  
  <!-- Specifies how the columns of a table should be laid out -->
  <xs:complexType name="tablespecType">
    <xs:sequence>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
	<xs:element name="fixed" type="fixedColumnType"/>
	<xs:element name="elastic" type="emptyType"/>
      </xs:choice>
    </xs:sequence>
    <xs:attribute name="token_type" type="xs:string" fixed="ignore-text"/>
  </xs:complexType>
  <xs:complexType name="tableSpecSettingType"/>

  <xs:complexType name="tableRowType">
    <xs:choice minOccurs="1" maxOccurs="unbounded">
      <xs:element name="td" type="tabledataType" />
      <xs:element name="th" type="tabledataType" />
      <xs:element
	  name="label" type="leafType"
	  minOccurs="0" maxOccurs="unbounded"/>
    </xs:choice>
    <xs:attribute name="newcolour" type="xs:boolean" default="true"/>
    <xs:attribute name="token_type" type="xs:string" fixed="ignore-text"/>
  </xs:complexType>

  <xs:simpleType name="tabledataAlignmentType" final="restriction" >
    <xs:restriction base="xs:string">
      <xs:enumeration value="l" />
      <xs:enumeration value="c" />
      <xs:enumeration value="r" />
      <xs:enumeration value="X" />
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="orderedListType" mixed="false">
    <xs:sequence>
      <xs:element
	  name="li"
	  type="blockType"
	  minOccurs="0" maxOccurs="unbounded"/>
      <xs:element
	  name="olist"
	  type="orderedListType"
	  minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute
	name="token_type"
	type="xs:string"
	fixed="ignore-text"/>
  </xs:complexType>

  <xs:complexType name="itemizedListType">
    <xs:sequence>
      <xs:element name="li" type="blockType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="token_type" type="xs:string" fixed="ignore-text"/>
  </xs:complexType>

  <xs:complexType name="sectionType">
    <xs:sequence>
      <xs:element name="sectiontitle" type="titleType" />
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="subsection" type="subsectionType" />
        <xs:element name="subsubsection" type="subsubsectionType" />
        <xs:element name="monsterblock" type="monsterblockType" />
        <xs:group ref="blockEnum"/>
	<xs:element name="sidebar" type="sidebarType"/>
      </xs:choice>
    </xs:sequence>
  </xs:complexType>
  <xs:element name="section" type="sectionType"/>


  <xs:complexType name="subsectionType">
    <xs:sequence>
      <xs:element name="subsectiontitle" type="titleType" />
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="subsubsection" type="subsubsectionType" />
        <xs:group ref="blockEnum"/>
	<xs:element name="sidebar" type="sidebarType"/>
      </xs:choice>
    </xs:sequence>
    <xs:attribute name="token_type" type="xs:string" fixed="ignore-text"/>
  </xs:complexType>
  <xs:element name="subsection" type="subsectionType"/>


  <xs:complexType name="subsubsectionType">
    <xs:sequence>
      <xs:element name="subsubsectiontitle" type="titleType" />
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="subsubsubsection" type="subsubsubsectionType" />
        <xs:group ref="blockEnum"/>
	<xs:element name="sidebar" type="sidebarType"/>
      </xs:choice>
    </xs:sequence>
    <xs:attribute name="token_type" type="xs:string" fixed="ignore-text"/>
  </xs:complexType>

  <xs:complexType name="subsubsubsectionType">
